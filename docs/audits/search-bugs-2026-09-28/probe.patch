@@ -0,0 +1,51 @@
+//! PROBE: バグ調査用の一時テスト（コミットしない）。
+
+use super::*;
+
+#[test]
+fn probe_delta_pruning_ignores_capture_promotion_gain() {
+    let position = crate::parse_sfen("11k/12/6p5/12/6O5/12/12/12/12/12/12/K11 b").unwrap();
+    let pst = weights().unwrap();
+    let stand_pat = crate::eval::evaluate(&pst, &position);
+    let moves = legal_moves(&position);
+    let mut best_capture = None;
+    for &mv in &moves {
+        let mut child = position.clone();
+        let undo = child.make_move_unchecked(mv, engine_rules());
+        if undo.captured.iter().flatten().next().is_some() {
+            let score = -crate::eval::evaluate(&pst, &child);
+            println!("capture {mv:?} promote={} child_score={score}", mv.promote);
+            best_capture = best_capture.max(Some(score));
+        }
+    }
+    println!("stand_pat={stand_pat} best_capture_static={best_capture:?}");
+    for (alpha, beta) in [(-INFINITY, INFINITY), (1300, 1301), (stand_pat + 200, stand_pat + 201)] {
+        with_root_searcher(&position, &[], |searcher| {
+            let mut current = position.clone();
+            let value = searcher.quiesce(&mut current, alpha, beta, 0).unwrap();
+            println!("quiesce window=({alpha},{beta}) -> {value}");
+        });
+    }
+}
+
+#[test]
+fn probe_stand_pat_with_last_royal_attacked() {
+    // codexの再現局面: 後手12j12kで先手の最後の王駒に王手。
+    let mut position =
+        crate::parse_sfen("11k/12/12/12/12/12/12/3b8/12/r2n8/P11/KP10 w").unwrap();
+    let pst = weights().unwrap();
+    for depth in 1..=3 {
+        let result = run_search(
+            &position,
+            engine_rules(),
+            &legal_moves(&position),
+            &[search_key(&position)],
+            &depth_limits(depth),
+            DEFAULT_THREADS,
+            &mut small_tt(),
+        );
+        println!("depth={depth} score={} best={:?}", result.score, result.best_move);
+    }
+    let _ = &mut position;
+    let _ = pst;
+}

+/// PROBE: null move診断の累積カウンタ。
+pub fn probe_counters() -> [u64; 4] {
+    use core::sync::atomic::Ordering::Relaxed;
+    [
+        searcher::PROBE_NULL_TRIES.load(Relaxed),
+        searcher::PROBE_NULL_CUTS.load(Relaxed),
+        searcher::PROBE_CROSS_NULL_REPS.load(Relaxed),
+        searcher::PROBE_IMMEDIATE_REPS.load(Relaxed),
+    ]
+}
+
+/// PROBE: 静止探索診断のカウンタ。
+pub fn probe_q_counters() -> [u64; 5] {
+    use core::sync::atomic::Ordering::Relaxed;
+    [
+        searcher::PROBE_Q_NODES.load(Relaxed),
+        searcher::PROBE_Q_PROMO_MISSED_NODES.load(Relaxed),
+        searcher::PROBE_SP_CUT.load(Relaxed),
+        searcher::PROBE_SP_CUT_LASTROYAL_ATTACKED.load(Relaxed),
+        searcher::PROBE_SP_NOCUT_LASTROYAL_ATTACKED.load(Relaxed),
+    ]
+}

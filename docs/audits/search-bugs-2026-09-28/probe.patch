+
+pub static PROBE_NULL_TRIES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_NULL_CUTS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_CROSS_NULL_REPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_IMMEDIATE_REPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub fn probe_skip() -> bool { std::env::var_os("PROBE_SKIP_CROSS_NULL").is_some() }
+
+pub static PROBE_Q_NODES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_Q_PROMO_MISSED_NODES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_Q_PROMO_MISSED_BETA: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_SP_CUT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_SP_CUT_LASTROYAL_ATTACKED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static PROBE_SP_NOCUT_LASTROYAL_ATTACKED: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn all_royals_attacked(position: &Position) -> bool {
+    let side = position.side_to_move();
+    let royals = position.royal_pieces(side);
+    !royals.is_empty() && royals.into_iter().all(|square| {
+        !position.attackers_to_by(side.opposite(), square, position.occupied()).is_empty()
+    })
+}
+
+pub(super) fn probe_standpat(position: &Position, cut: bool) {
+    if std::env::var_os("PROBE_Q").is_none() { return; }
+    use std::sync::atomic::Ordering::Relaxed;
+    let attacked = all_royals_attacked(position);
+    if cut {
+        PROBE_SP_CUT.fetch_add(1, Relaxed);
+        if attacked { PROBE_SP_CUT_LASTROYAL_ATTACKED.fetch_add(1, Relaxed); }
+    } else if attacked {
+        PROBE_SP_NOCUT_LASTROYAL_ATTACKED.fetch_add(1, Relaxed);
+    }
+}
+
+pub(super) fn probe_qsearch(searcher: &Searcher<'_>, position: &Position, threshold: i32) {
+    if std::env::var_os("PROBE_Q").is_none() { return; }
+    use std::sync::atomic::Ordering::Relaxed;
+    PROBE_Q_NODES.fetch_add(1, Relaxed);
+    let mut moves = Vec::new();
+    searcher.generator.generate_captures(position, &mut moves);
+    let mut missed = false;
+    for mv in moves {
+        if !mv.promote || MoveGenerator::is_excluded_lion_capture(position, mv) { continue; }
+        let captured: i32 = position.captured_squares(mv).into_iter().flatten()
+            .map(|sq| searcher.pst.piece_value(position.piece_at(sq).unwrap())).sum();
+        let piece = position.piece_at(mv.from).unwrap();
+        let gain = searcher.pst.piece_value(piece.promote().unwrap()) - searcher.pst.piece_value(piece);
+        if captured <= threshold && captured + gain > threshold {
+            missed = true;
+        }
+    }
+    if missed { PROBE_Q_PROMO_MISSED_NODES.fetch_add(1, Relaxed); }
+}

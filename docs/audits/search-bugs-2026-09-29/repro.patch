+// docs/plans/lazy-smp.md:118-119 requires any worker that completes the requested
+// depth to stop the team. The main worker is deliberately delayed until the
+// auxiliary completes, to make this permitted scheduling deterministic.
+#[test]
+fn audit_auxiliary_depth_completion_stops_later_main_work() {
+    let position = Position::initial();
+    let roots = legal_moves(&position);
+    let pst = weights().unwrap();
+    let table = small_tt();
+    let external_stop = AtomicBool::new(false);
+    let shared = SharedSearch {
+        external_stop: &external_stop,
+        team_stop: AtomicBool::new(false),
+        stop_reason: AtomicU8::new(0),
+        total_nodes: AtomicU64::new(0),
+        node_limit: None,
+        started: Instant::now(),
+        hard_limit: None,
+    };
+    let auxiliary_completed = std::sync::Barrier::new(2);
+    let outcomes = run_worker_team(worker_count(2), &shared, |worker_index| {
+        if worker_index == 1 {
+            let outcome = run_auxiliary_worker(
+                &pst,
+                &position,
+                engine_rules(),
+                &roots,
+                &[],
+                1,
+                1,
+                &shared,
+                &table,
+            );
+            assert_eq!(outcome.result.depth, 1);
+            auxiliary_completed.wait();
+            outcome
+        } else {
+            auxiliary_completed.wait();
+            run_main_worker(
+                &pst,
+                &position,
+                engine_rules(),
+                &roots,
+                &[],
+                1,
+                None,
+                &shared,
+                &table,
+                None,
+                false,
+            )
+        }
+    });
+    let main = outcomes
+        .iter()
+        .find(|outcome| outcome.worker_index == 0)
+        .unwrap();
+    let adopted = select_worker_outcome(&outcomes);
+    eprintln!(
+        "main_depth={} main_nodes={} adopted_worker={} adopted_depth={} total_nodes={}",
+        main.result.depth,
+        main.nodes,
+        adopted.worker_index,
+        adopted.result.depth,
+        shared.nodes()
+    );
+    assert_eq!(
+        main.result.depth, 0,
+        "main must stop when an auxiliary has completed depth 1"
+    );
+    assert_eq!(
+        main.nodes, 0,
+        "no main work may start after the depth limit was reached"
+    );
+    assert_eq!(adopted.worker_index, 1);
+    assert_eq!(shared.reason(), StopReason::DepthCompleted);
+}

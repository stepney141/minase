+// MNPT permits every positive pawn value. Update its royal values and checksum
+// as required by the independent format contract before using the public API.
+fn pst_with_pawn_value(value: i32) -> Pst {
+    let mut bytes = include_bytes!("../../../../nets/pst.bin").to_vec();
+    let values_start = bytes.len() - PIECE_STATE_COUNT * 4;
+    let pawn = piece_state_of(PieceCode::new(Color::Black, PieceKind::Pawn).unwrap());
+    let pawn_offset = values_start + pawn * 4;
+    bytes[pawn_offset..pawn_offset + 4].copy_from_slice(&value.to_le_bytes());
+    let max_non_royal = (0..PIECE_STATE_COUNT)
+        .filter(|&state| {
+            state != PieceKind::King.index() && state != PieceKind::CrownPrince.index()
+        })
+        .map(|state| {
+            let offset = values_start + state * 4;
+            i32::from_le_bytes(bytes[offset..offset + 4].try_into().unwrap())
+        })
+        .max()
+        .unwrap();
+    for kind in [PieceKind::King, PieceKind::CrownPrince] {
+        let offset = values_start + kind.index() * 4;
+        bytes[offset..offset + 4].copy_from_slice(&(max_non_royal + value).to_le_bytes());
+    }
+    let checksum: [u8; 32] = Sha256::digest(&bytes[80..]).into();
+    bytes[48..80].copy_from_slice(&checksum);
+    let pst = Pst::decode(&bytes).expect("positive pawn value satisfies the MNPT contract");
+    assert_eq!(pst.pawn_value(), value);
+    pst
+}

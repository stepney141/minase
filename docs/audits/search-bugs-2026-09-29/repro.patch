+// SearchLimits allows depth 5, and a finite completed iteration must be reachable
+// for every validated Pst. The node cap prevents a broken search from hanging.
+#[test]
+fn audit_positive_pawn_values_allow_depth_five_to_complete() {
+    let root = crate::parse_sfen("k11/12/12/12/12/12/12/12/12/12/12/11K b").unwrap();
+    let snapshot = snapshot_for(&root);
+    let limits = SearchLimits::new(Some(5), Some(10_000), None, None).unwrap();
+    let mut depths = Vec::new();
+    for pawn in [100, 1, 2] {
+        let pst = pst_with_pawn_value(pawn);
+        let result =
+            crate::search::search(&pst, &snapshot, &limits, DEFAULT_THREADS, &mut small_tt())
+                .unwrap();
+        let delta = aspiration_delta(pawn);
+        let mut window = AspirationWindow::initial(5, Some(0), delta);
+        window.widen_low();
+        window.widen_high();
+        eprintln!(
+            "pawn={pawn}: depth={}, nodes={}, delta={delta}, widened=({}, {}, {})",
+            result.depth, result.nodes, window.alpha, window.beta, window.delta
+        );
+        depths.push(result.depth);
+    }
+    assert_eq!(
+        depths,
+        vec![5, 5, 5],
+        "valid small pawn values must not prevent completion"
+    );
+}

+// A hypothetical null move is not a real game move and cannot complete a repetition.
+// Both lions are distant and Black has an extra free king; a White jitto cannot draw.
+#[test]
+fn audit_null_move_jitto_must_not_draw_against_pre_null_history() {
+    let root = position(
+        Color::Black,
+        &[
+            (fs(1, 12), Color::Black, PieceKind::King),
+            (fs(4, 10), Color::Black, PieceKind::Lion),
+            (fs(6, 11), Color::Black, PieceKind::FreeKing),
+            (fs(12, 1), Color::White, PieceKind::King),
+            (fs(9, 3), Color::White, PieceKind::Lion),
+        ],
+    );
+    assert!(evaluate(&weights().unwrap(), &root) > 0);
+    let mut after_null = root.clone();
+    after_null.make_null_move();
+    let reply = legal_moves(&after_null)
+        .into_iter()
+        .find(|mv| mv.from == mv.to)
+        .unwrap();
+    let mut returned = after_null.clone();
+    returned.make_move_unchecked(reply, engine_rules());
+    assert_eq!(search_key(&returned), search_key(&root));
+    let expected = -run_quiesce(&root, -INFINITY, INFINITY, 0, &small_tt()).0;
+    assert!(expected < 0);
+    with_root_searcher(&root, &[search_key(&root)], |searcher| {
+        // Enter the state reached by the existing null-move branch.
+        searcher.null_move_ply = Some(1);
+        searcher.accumulators[1] = searcher.pst.refresh_accumulator(&after_null);
+        searcher.material_keys[1] = material_key(&after_null);
+        let actual = searcher
+            .search_move(&mut after_null, reply, 1, -INFINITY, INFINITY, 1, true, 0)
+            .unwrap();
+        eprintln!(
+            "null then jitto: expected={expected}, actual={actual}, nodes={}",
+            searcher.nodes
+        );
+        assert_eq!(
+            actual, expected,
+            "null move cannot count toward a repetition"
+        );
+    });
+}

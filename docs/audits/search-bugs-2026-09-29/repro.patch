+// search.md requires capture-promotions to be included in quiescence.
+// This undefended pawn capture promotes a kirin to a lion, exceeding beta.
+#[test]
+fn audit_delta_pruning_must_keep_a_profitable_capture_promotion() {
+    let root = crate::parse_sfen("11k/12/6p5/12/6O5/12/12/12/12/12/12/K11 b").unwrap();
+    let mv = Move {
+        from: fs(6, 5),
+        mid: None,
+        to: fs(6, 3),
+        promote: true,
+    };
+    assert!(legal_moves(&root).contains(&mv));
+    let mut child = root.clone();
+    child.make_move_unchecked(mv, engine_rules());
+    let value_after_capture = -evaluate(&weights().unwrap(), &child);
+    assert!(value_after_capture >= 1301);
+    let full = run_quiesce(&root, -INFINITY, INFINITY, 0, &small_tt());
+    let narrow = run_quiesce(&root, 1300, 1301, 0, &small_tt());
+    eprintln!(
+        "promotion: static={}, capture_value={value_after_capture}, full={full:?}, narrow={narrow:?}",
+        evaluate(&weights().unwrap(), &root)
+    );
+    assert!(
+        narrow.0 >= 1301,
+        "a capture above beta must not be reported as fail-low"
+    );
+}

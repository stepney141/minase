+#[test]
+fn audit_no_legal_move_remains_a_loss_under_null_pruning() {
+    // RULES.md article 23: no legal move loses, independently of depth/window.
+    let position = position(
+        Color::Black,
+        &[
+            (sq(0, 11), Color::Black, PieceKind::King),
+            (sq(1, 11), Color::Black, PieceKind::Pawn),
+            (sq(0, 10), Color::Black, PieceKind::Pawn),
+            (sq(1, 10), Color::Black, PieceKind::Pawn),
+            (sq(11, 0), Color::White, PieceKind::King),
+        ],
+    );
+    assert!(legal_moves(&position).is_empty());
+    let exact = run_negamax(&position, 1, -INFINITY, INFINITY, 0, &small_tt());
+    assert_eq!(exact.0, -MATE);
+    let mut after_null = position.clone();
+    after_null.make_null_move();
+    let beta = -evaluate(&weights().unwrap(), &after_null);
+    let actual = run_negamax(&position, 4, beta - 1, beta, 0, &small_tt());
+    eprintln!("exact={exact:?}, beta={beta}, depth4={actual:?}");
+    assert_eq!(
+        actual.0, -MATE,
+        "a terminal loss cannot become a null-move lower bound"
+    );
+}

+// docs/plans/lazy-smp.md:94-99: partial spawn failure must fail the team and
+// collect its existing workers. Run only with the EAGAIN injector at spawn 3:
+// test harness thread, first auxiliary, then failed second auxiliary.
+#[test]
+#[ignore = "requires the process-local pthread_create failure injector"]
+fn audit_partial_spawn_failure_stops_existing_auxiliary() {
+    assert_eq!(std::env::var("MINASE_REVIEW_FAIL_PTHREAD_AT").unwrap(), "3");
+    let fallback = legal_moves(&Position::initial())[0];
+    let external_stop = AtomicBool::new(false);
+    let shared = SharedSearch {
+        external_stop: &external_stop,
+        team_stop: AtomicBool::new(false),
+        stop_reason: AtomicU8::new(0),
+        total_nodes: AtomicU64::new(0),
+        node_limit: None,
+        started: Instant::now(),
+        hard_limit: None,
+    };
+    let timed_out = AtomicBool::new(false);
+    let outcome = catch_unwind(AssertUnwindSafe(|| {
+        run_worker_team(worker_count(3), &shared, |worker_index| {
+            // This deadline belongs only to the probe, so a missing stop cannot
+            // leave a test worker alive indefinitely.
+            let deadline = Instant::now() + Duration::from_millis(100);
+            while !shared.team_stop.load(AtomicOrdering::Acquire) {
+                if Instant::now() >= deadline {
+                    timed_out.store(true, AtomicOrdering::Release);
+                    break;
+                }
+                thread::sleep(Duration::from_millis(1));
+            }
+            WorkerOutcome {
+                worker_index,
+                result: SearchResult {
+                    #[cfg(feature = "search-stats")]
+                    stats: crate::search::SearchStats::default(),
+                    best_move: fallback,
+                    score: 0,
+                    depth: 0,
+                    nodes: 0,
+                },
+                pv: vec![fallback],
+                nodes: 0,
+            }
+        })
+    }));
+    eprintln!(
+        "spawn_failed={} team_stop={} watchdog_expired={}",
+        outcome.is_err(),
+        shared.team_stop.load(AtomicOrdering::Acquire),
+        timed_out.load(AtomicOrdering::Acquire)
+    );
+    assert!(outcome.is_err(), "injected spawn failure must propagate");
+    assert!(
+        !timed_out.load(AtomicOrdering::Acquire),
+        "existing auxiliary must receive a stop instead of needing the probe watchdog"
+    );
+}

+//! Reproductions for the control audit of master c76eaea.
+
+use super::*;
+use sha2::{Digest, Sha256};
+
+// The weight format accepts pawn values 1 and 2. Update royal values and checksum
+// as required by the independent format contract before using the public API.
+fn pst_with_pawn_value(value: i32) -> Pst {
+    let mut bytes = include_bytes!("../../../../nets/pst.bin").to_vec();
+    let values_start = bytes.len() - PIECE_STATE_COUNT * 4;
+    let pawn = piece_state_of(PieceCode::new(Color::Black, PieceKind::Pawn).unwrap());
+    let pawn_offset = values_start + pawn * 4;
+    bytes[pawn_offset..pawn_offset + 4].copy_from_slice(&value.to_le_bytes());
+    let max_non_royal = (0..PIECE_STATE_COUNT)
+        .filter(|&state| {
+            state != PieceKind::King.index() && state != PieceKind::CrownPrince.index()
+        })
+        .map(|state| {
+            let offset = values_start + state * 4;
+            i32::from_le_bytes(bytes[offset..offset + 4].try_into().unwrap())
+        })
+        .max()
+        .unwrap();
+    for kind in [PieceKind::King, PieceKind::CrownPrince] {
+        let offset = values_start + kind.index() * 4;
+        bytes[offset..offset + 4].copy_from_slice(&(max_non_royal + value).to_le_bytes());
+    }
+    let checksum: [u8; 32] = Sha256::digest(&bytes[80..]).into();
+    bytes[48..80].copy_from_slice(&checksum);
+    let pst = Pst::decode(&bytes).expect("positive pawn value satisfies the MNPT contract");
+    assert_eq!(pst.pawn_value(), value);
+    pst
+}
+
+// SearchLimits allows depth 5, and a finite completed iteration must be reachable
+// for every validated Pst. The node cap prevents a broken search from hanging.
+#[test]
+fn audit_positive_pawn_values_allow_depth_five_to_complete() {
+    let root = crate::parse_sfen("k11/12/12/12/12/12/12/12/12/12/12/11K b").unwrap();
+    let snapshot = snapshot_for(&root);
+    let limits = SearchLimits::new(Some(5), Some(10_000), None, None).unwrap();
+    let mut depths = Vec::new();
+    for pawn in [100, 1, 2] {
+        let pst = pst_with_pawn_value(pawn);
+        let result =
+            crate::search::search(&pst, &snapshot, &limits, DEFAULT_THREADS, &mut small_tt())
+                .unwrap();
+        let delta = aspiration_delta(pawn);
+        let mut window = AspirationWindow::initial(5, Some(0), delta);
+        window.widen_low();
+        window.widen_high();
+        eprintln!(
+            "pawn={pawn}: depth={}, nodes={}, delta={delta}, widened=({}, {}, {})",
+            result.depth, result.nodes, window.alpha, window.beta, window.delta
+        );
+        depths.push(result.depth);
+    }
+    assert_eq!(
+        depths,
+        vec![5, 5, 5],
+        "valid small pawn values must not prevent completion"
+    );
+}

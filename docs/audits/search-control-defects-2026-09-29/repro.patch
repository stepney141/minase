+#[test]
+fn review_extra_pawn_values() {
+    let root = crate::parse_sfen("k11/12/12/12/12/12/12/12/12/12/12/11K b").unwrap();
+    let snapshot = snapshot_for(&root);
+    for (pawn, nodes) in [(3, 10_000u64), (4, 10_000), (1, 100_000), (100, 100_000)] {
+        let limits = SearchLimits::new(Some(5), Some(nodes), None, None).unwrap();
+        let pst = pst_with_pawn_value(pawn);
+        let r = crate::search::search(&pst, &snapshot, &limits, DEFAULT_THREADS, &mut small_tt())
+            .unwrap();
+        let d4 = SearchLimits::new(Some(4), None, None, None).unwrap();
+        let r4 =
+            crate::search::search(&pst, &snapshot, &d4, DEFAULT_THREADS, &mut small_tt()).unwrap();
+        eprintln!(
+            "extra pawn={pawn} cap={nodes}: depth={} nodes={} delta={} d4_score={} d4_nodes={}",
+            r.depth,
+            r.nodes,
+            aspiration_delta(pawn),
+            r4.score,
+            r4.nodes
+        );
+    }
+}

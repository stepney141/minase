+// ---- 診断用の一時コード（コミットしない） ----
+
+/// 置換表の切除実験の方式。
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(super) enum DiagMode {
+    Full,
+    Off,
+    MoveOnly,
+    NoMove,
+    NoCut,
+    NoQs,
+    SfSave,
+}
+
+pub(super) struct Diag {
+    pub(super) mode: DiagMode,
+    fresh: bool,
+    classify: bool,
+}
+
+pub(super) fn diag() -> &'static Diag {
+    static DIAG: OnceLock<Diag> = OnceLock::new();
+    DIAG.get_or_init(|| {
+        let mode = match std::env::var("MINASE_TT_MODE").ok().as_deref() {
+            None | Some("full") => DiagMode::Full,
+            Some("off") => DiagMode::Off,
+            Some("moveonly") => DiagMode::MoveOnly,
+            Some("nomove") => DiagMode::NoMove,
+            Some("nocut") => DiagMode::NoCut,
+            Some("noqs") => DiagMode::NoQs,
+            Some("sfsave") => DiagMode::SfSave,
+            Some(other) => panic!("unknown MINASE_TT_MODE {other}"),
+        };
+        Diag {
+            mode,
+            fresh: std::env::var("MINASE_TT_FRESH").is_ok(),
+            classify: std::env::var("MINASE_TT_DIAG").is_ok(),
+        }
+    })
+}
+
+pub(super) fn cutoffs_enabled() -> bool {
+    diag().mode != DiagMode::NoCut
+}
+
+pub(super) fn qs_enabled() -> bool {
+    diag().mode != DiagMode::NoQs
+}
+
+thread_local! {
+    static SITE: Cell<usize> = const { Cell::new(0) };
+    static TAG: Cell<u16> = const { Cell::new(0) };
+}
+
+static PROBES: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+static HITS: [AtomicU64; 16] = [const { AtomicU64::new(0) }; 16];
+static HIT_MOVES: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+static CUTOFFS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+static DEPTH_OK: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+static STORES: [AtomicU64; 21] = [const { AtomicU64::new(0) }; 21];
+
+/// 照会または保存の直前に、呼び出し元の種別（0は通常探索と根、1は静止探索）、
+/// 反復の深さ、および根からの経路の署名を記録する。
+pub(super) fn diag_enter(site: usize, root_depth: u32, path_keys: &[u64]) {
+    if !diag().classify {
+        return;
+    }
+    let mut hash: u64 = 0x9e37_79b9_7f4a_7c15;
+    for key in &path_keys[..path_keys.len() - 1] {
+        hash = (hash ^ key).wrapping_mul(0x0000_0100_0000_01b3);
+        hash ^= hash >> 29;
+    }
+    SITE.set(site);
+    TAG.set(((root_depth.min(63) as u16) << 9) | (hash & 0x1ff) as u16);
+}
+
+pub(super) fn diag_cutoff(site: usize, origin: u8) {
+    if diag().classify {
+        CUTOFFS[site * 4 + origin as usize].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+pub(super) fn diag_depth_ok(origin: u8) {
+    if diag().classify {
+        DEPTH_OK[origin as usize].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+fn diag_store(kind: usize, existing: Option<&CriticalFields>, key: u32, age: u8, replace: bool) {
+    if !diag().classify {
+        return;
+    }
+    let outcome = match existing {
+        None => 0,
+        Some(existing) if existing.key == key => {
+            if replace {
+                1
+            } else {
+                2
+            }
+        }
+        Some(existing) => {
+            let existing_deep = existing.value.is_some_and(|value| value.depth >= 1);
+            if !replace {
+                6
+            } else if age > 0 {
+                if existing_deep { 3 } else { 4 }
+            } else {
+                5
+            }
+        }
+    };
+    STORES[kind * 7 + outcome].fetch_add(1, Ordering::Relaxed);
+}
+
+fn load_all(counters: &[AtomicU64]) -> Vec<u64> {
+    counters
+        .iter()
+        .map(|counter| counter.load(Ordering::Relaxed))
+        .collect()
+}
+
+impl Drop for TranspositionTable {
+    fn drop(&mut self) {
+        if !diag().classify || PROBES[0].load(Ordering::Relaxed) == 0 {
+            return;
+        }
+        let generation = *self.generation.get_mut();
+        let (mut deep, mut shallow, mut eval_only, mut current) = (0u64, 0u64, 0u64, 0u64);
+        for entry in &self.entries {
+            let Some(fields) = unpack_critical(entry.critical.load(Ordering::Relaxed)) else {
+                continue;
+            };
+            match fields.value {
+                Some(value) if value.depth >= 1 => deep += 1,
+                Some(_) => shallow += 1,
+                None => eval_only += 1,
+            }
+            if unpack_advisory_generation(entry.advisory.load(Ordering::Relaxed)) == generation {
+                current += 1;
+            }
+        }
+        eprintln!(
+            "ttdiag {{\"mode\":\"{:?}\",\"entries\":{},\"generation\":{},\"occ_deep\":{},\"occ_shallow\":{},\"occ_eval_only\":{},\"occ_current_gen\":{},\"probes\":{:?},\"hits\":{:?},\"hit_moves\":{:?},\"cutoffs\":{:?},\"depth_ok\":{:?},\"stores\":{:?}}}",
+            diag().mode,
+            self.entries.len(),
+            generation,
+            deep,
+            shallow,
+            eval_only,
+            current,
+            load_all(&PROBES),
+            load_all(&HITS),
+            load_all(&HIT_MOVES),
+            load_all(&CUTOFFS),
+            load_all(&DEPTH_OK),
+            load_all(&STORES),
+        );
+    }
+}

+/// 1回の診断のための一時的な処理であり、本線には入れない。
+fn generate_diagnostic_opening(
+    rules: Rules,
+    pair_seed: NonZeroU64,
+    path: &std::ffi::OsStr,
+) -> Opening {
+    let base_seed = std::env::var("MINASE_DIAG_BASE_SEED")
+        .expect("MINASE_DIAG_BASE_SEED must be set to a decimal u64")
+        .parse::<u64>()
+        .expect("MINASE_DIAG_BASE_SEED must be a decimal u64");
+    let openings = std::fs::read_to_string(path)
+        .unwrap_or_else(|error| panic!("failed to read MINASE_DIAG_OPENINGS {path:?}: {error}"));
+    let (line_number, line) = (1..)
+        .zip(openings.lines())
+        .find(|(line_number, _)| derive_seed(base_seed, *line_number) == pair_seed)
+        .unwrap_or_else(|| {
+            panic!("MINASE_DIAG_OPENINGS has no line matching pair_seed {pair_seed}")
+        });
+
+    let mut game = Game::new(rules);
+    let mut moves = Vec::new();
+    let mut usi_moves = Vec::new();
+    for (index, text) in line.split_whitespace().enumerate() {
+        let ply = index + 1;
+        let mv = usi::parse(game.position(), text).unwrap_or_else(|error| {
+            panic!("invalid USI move at line {line_number}, ply {ply}: {text}: {error}")
+        });
+        let status = game.play(mv).unwrap_or_else(|error| {
+            panic!("illegal move at line {line_number}, ply {ply}: {text}: {error}")
+        });
+        assert!(
+            !matches!(status, GameStatus::Finished(_)),
+            "game finished at line {line_number}, ply {ply}: {text}"
+        );
+        moves.push(mv);
+        usi_moves.push(text.to_owned());
+    }
+
+    Opening {
+        game,
+        seed: derive_seed(pair_seed.get(), 0),
+        moves,
+        usi_moves,
+    }
+}

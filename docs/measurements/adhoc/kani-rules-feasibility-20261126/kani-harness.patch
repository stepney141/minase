+#[cfg(kani)]
+mod kani_proofs {
+    use super::*;
+
+    fn any_square() -> Square {
+        let file: u8 = kani::any();
+        let rank: u8 = kani::any();
+        kani::assume(file < 12 && rank < 12);
+        Square::new(file, rank).unwrap()
+    }
+
+    /// 標準規則（P0）の成りの選択が、第17条から第19条を段の数値で書いた式と全入力で一致する。
+    #[kani::proof]
+    fn standard_promotion_choice() {
+        let color = if kani::any() { Color::Black } else { Color::White };
+        let kind_index: u8 = kani::any();
+        kani::assume(kind_index < 29);
+        let kind = PieceKind::from_index(kind_index).unwrap();
+        let is_promoted: bool = kani::any();
+        let from = any_square();
+        let to = any_square();
+        let has_capture: bool = kani::any();
+        let deferred: bool = kani::any();
+
+        let zone = |rank: u8| match color {
+            Color::Black => rank >= 8,
+            Color::White => rank <= 3,
+        };
+        let last_rank = match color {
+            Color::Black => to.rank() == 11,
+            Color::White => to.rank() == 0,
+        };
+        // 第17条。成り先の有無は本番の`PieceKind::promoted`を借りる。
+        let promotable_kind = !is_promoted && kind.promoted().is_some();
+        // 第18条第1項、第2項、および第19条第1項。
+        let chance = (!zone(from.rank()) && zone(to.rank()))
+            || (has_capture && zone(from.rank()))
+            || (has_capture && zone(to.rank()))
+            || (kind == PieceKind::Pawn && !has_capture && last_rank);
+        let expected = if promotable_kind && chance {
+            PromotionChoice::PromotionOptional
+        } else {
+            PromotionChoice::NoPromotion
+        };
+        assert_eq!(
+            MoveRules::standard().promotion_choice_for(
+                color, kind, is_promoted, from, to, has_capture, deferred
+            ),
+            expected
+        );
+    }
+}

+#[cfg(kani)]
+mod kani_proofs {
+    use super::*;
+    use crate::board::step_square;
+
+    fn any_square() -> Square {
+        let file: u8 = kani::any();
+        let rank: u8 = kani::any();
+        kani::assume(file < 12 && rank < 12);
+        Square::new(file, rank).unwrap()
+    }
+
+    fn any_direction() -> Direction {
+        let index: usize = kani::any();
+        kani::assume(index < 8);
+        Direction::ALL[index]
+    }
+
+    fn any_bitboard() -> Bitboard {
+        Bitboard::from_words([kani::any(), kani::any(), kani::any()])
+    }
+
+    /// 走りの利きだけを持つ表。他の表は`sliding_control`が読まない。
+    fn ray_only_tables() -> AttackTables {
+        AttackTables {
+            rays: Box::new(build_ray_table()),
+            fixed: Box::new([]),
+            fixed_attacker_kinds: [[0; 69]; COLOR_COUNT],
+            reach: Box::new([]),
+            slide_directions: [[0; MOVEMENT_PROFILE_COUNT]; COLOR_COUNT],
+            neighbourhoods: [Bitboard::EMPTY; RAW_SQUARE_COUNT],
+            attack_dependencies: [Bitboard::EMPTY; RAW_SQUARE_COUNT],
+            lion_jumps: [Bitboard::EMPTY; RAW_SQUARE_COUNT],
+        }
+    }
+
+    /// 第7条第4項と第5項の文言どおりに1升ずつ進む仕様側の定義。
+    /// 盤は12升幅なので、歩行は11歩以内に盤端へ達する。
+    fn walk(from: Square, direction: Direction, occupied: Bitboard) -> Bitboard {
+        let mut expected = Bitboard::EMPTY;
+        let mut current = from;
+        for _ in 0..11 {
+            let Some(next) = step_square(current, direction) else {
+                break;
+            };
+            expected.set(next);
+            if occupied.contains(next) {
+                break;
+            }
+            current = next;
+        }
+        expected
+    }
+
+    /// 始点、方向、占有（2^144通り）をすべて記号化し、利き線の表だけを構築する。
+    #[kani::proof]
+    fn sliding_symbolic_origin() {
+        let tables = ray_only_tables();
+        let from = any_square();
+        let direction = any_direction();
+        let occupied = any_bitboard();
+        assert_eq!(
+            tables.sliding_control(from, direction, occupied),
+            walk(from, direction, occupied)
+        );
+    }
+
+    /// 始点と方向を具体値で列挙し、占有だけを記号化する。
+    #[kani::proof]
+    fn sliding_enumerated_origin() {
+        let tables = ray_only_tables();
+        let occupied = any_bitboard();
+        for from in Square::all() {
+            for direction in Direction::ALL {
+                assert_eq!(
+                    tables.sliding_control(from, direction, occupied),
+                    walk(from, direction, occupied)
+                );
+            }
+        }
+    }
+
+    /// 本番と同じ入口`attack_tables()`で全表を構築する。
+    #[kani::proof]
+    fn sliding_production_tables() {
+        let from = any_square();
+        let direction = any_direction();
+        let occupied = any_bitboard();
+        assert_eq!(
+            attack_tables().sliding_control(from, direction, occupied),
+            walk(from, direction, occupied)
+        );
+    }
+}

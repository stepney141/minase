+//! PROTOTYPE: sample real sliding queries; never use this build for timing.
+use std::cell::RefCell;
+
+use crate::{Bitboard, Direction, Square};
+
+#[derive(Default)]
+struct Trace {
+    enabled: bool,
+    count: [u64; 8],
+    sampled: [u64; 8],
+    sequence: u64,
+    data: Vec<u8>,
+}
+
+thread_local! {
+    static TRACE: RefCell<Trace> = RefCell::new(Trace::default());
+}
+
+/// Restrict collection to the measured search calls on this one worker.
+pub fn enable(value: bool) {
+    TRACE.with_borrow_mut(|trace| trace.enabled = value);
+}
+
+/// Sample one in 32 queries using a fixed, mixed sequence number.
+pub(crate) fn record(from: Square, direction: Direction, occupied: Bitboard) {
+    TRACE.with_borrow_mut(|trace| {
+        if !trace.enabled {
+            return;
+        }
+        trace.count[direction.index()] += 1;
+        trace.sequence += 1;
+        let mut z = trace.sequence.wrapping_add(0x9e37_79b9_7f4a_7c15);
+        z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+        z ^= z >> 31;
+        if z >> 59 != 0 {
+            return;
+        }
+        trace.sampled[direction.index()] += 1;
+        let tag = u64::from(from.raw()) | ((direction.index() as u64) << 8);
+        trace.data.extend_from_slice(&tag.to_le_bytes());
+        for word in occupied.words() {
+            trace.data.extend_from_slice(&word.to_le_bytes());
+        }
+    });
+}
+
+/// Save the sampled input records and exact direction counts.
+pub fn save() {
+    TRACE.with_borrow(|trace| {
+        assert_eq!(trace.count.iter().sum::<u64>(), trace.sequence);
+        assert_eq!(trace.sampled.iter().sum::<u64>() as usize * 32, trace.data.len());
+        let path = std::env::var("MAGIC_TRACE_OUTPUT").expect("MAGIC_TRACE_OUTPUT is required");
+        std::fs::write(&path, &trace.data).expect("write sampled queries");
+        eprintln!("calls={:?} sampled={:?} bytes={}", trace.count, trace.sampled, trace.data.len());
+    });
+}

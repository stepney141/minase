+//! 規則書の読みが分かれる箇所について、本番の挙動を公開APIで観測する使い捨ての試験。
+//! 座標は`Square::new(筋, 段)`の内部の値である。
+
+use minase_core::rules::parse_rule_set;
+use minase_core::{
+    Color, Game, GameStatus, Move, MoveGenerator, PieceCode, PieceKind, Position, PositionBuilder,
+    Rules, Square,
+};
+
+fn sq(file: u8, rank: u8) -> Square {
+    Square::new(file, rank).unwrap()
+}
+
+fn mv(from: (u8, u8), mid: Option<(u8, u8)>, to: (u8, u8), promote: bool) -> Move {
+    Move {
+        from: sq(from.0, from.1),
+        mid: mid.map(|m| sq(m.0, m.1)),
+        to: sq(to.0, to.1),
+        promote,
+    }
+}
+
+fn step(from: (u8, u8), to: (u8, u8)) -> Move {
+    mv(from, None, to, false)
+}
+
+fn rules(set: &str) -> Rules {
+    Rules::from_codes(&parse_rule_set(set).unwrap()).unwrap()
+}
+
+fn unpromoted(color: Color, kind: PieceKind) -> PieceCode {
+    PieceCode::new(color, kind).unwrap()
+}
+
+fn legal(generator: &MoveGenerator, position: &Position, candidate: Move) -> bool {
+    let mut moves = Vec::new();
+    generator.generate_moves(position, &mut moves);
+    moves.contains(&candidate)
+}
+
+/// 論点1: 双方の獅子がなくなった後に残る先獅子の記録と反復（第24条第1項c）。
+#[test]
+fn reading_1_lion_capture_record_without_remaining_lion() {
+    for set in ["L0,P0,R2,E1,E2", "L0,P0,R3,E1,E2", "L0,P0,R1,E1,E2"] {
+        let mut game = Game::new(rules(set));
+        let mut moves = vec![
+            step((3, 4), (3, 5)),
+            step((6, 9), (6, 7)),
+            step((3, 5), (3, 4)),
+            step((6, 7), (6, 5)),
+            step((3, 4), (3, 5)),
+            step((6, 5), (6, 3)),
+            step((3, 5), (3, 4)),
+            step((6, 3), (5, 2)),
+            step((6, 2), (5, 2)),
+        ];
+        for _ in 0..5 {
+            moves.extend([
+                step((8, 7), (8, 6)),
+                step((3, 4), (3, 5)),
+                step((8, 6), (8, 7)),
+                step((3, 5), (3, 4)),
+            ]);
+        }
+        let mut key_after_ply_9 = 0;
+        for (index, played) in moves.into_iter().enumerate() {
+            let ply = index + 1;
+            match game.play(played) {
+                Ok(status) => {
+                    let key = *game.repetition_key_history().last().unwrap();
+                    if ply == 9 {
+                        key_after_ply_9 = key;
+                    }
+                    if ply == 9 || ply == 13 || status != GameStatus::Ongoing {
+                        println!(
+                            "reading1 {set} ply {ply}: {status:?} record={:?} key_equals_ply_9={}",
+                            game.position()
+                                .lion_capture_square()
+                                .map(|square| (square.file(), square.rank())),
+                            key == key_after_ply_9
+                        );
+                    }
+                    if status != GameStatus::Ongoing {
+                        break;
+                    }
+                }
+                Err(error) => {
+                    println!("reading1 {set} ply {ply}: rejected {error:?}");
+                    break;
+                }
+            }
+        }
+    }
+}
+
+/// 論点2: 成り権を保留した駒が非捕獲で1升進む手の不成（N）と成り（P）（第30条）。
+#[test]
+fn reading_2_deferred_piece_reaching_the_last_rank() {
+    for set in [
+        "L0,P2,R1,E0",
+        "L0,P2,P3,R1,E0",
+        "L0,P2,P3,P6,R1,E0",
+        "L0,P2,P5,P6,R1,E0",
+    ] {
+        for deferred in [true, false] {
+            let mut builder = PositionBuilder::new(Color::Black);
+            let pieces = [
+                (sq(0, 10), unpromoted(Color::Black, PieceKind::Lance)),
+                (sq(1, 10), unpromoted(Color::Black, PieceKind::Pawn)),
+                (sq(2, 9), unpromoted(Color::Black, PieceKind::SilverGeneral)),
+                (sq(5, 0), unpromoted(Color::Black, PieceKind::King)),
+                (sq(5, 5), unpromoted(Color::White, PieceKind::King)),
+            ];
+            for (square, piece) in pieces {
+                builder.put(square, piece).unwrap();
+            }
+            if deferred {
+                for square in [sq(0, 10), sq(1, 10), sq(2, 9)] {
+                    builder.mark_promotion_deferred(square).unwrap();
+                }
+            }
+            let position = builder.finish().unwrap();
+            let generator = MoveGenerator::new(rules(set).moves);
+            let choices = |from: (u8, u8), to: (u8, u8)| {
+                format!(
+                    "{}{}",
+                    if legal(&generator, &position, mv(from, None, to, false)) { "N" } else { "-" },
+                    if legal(&generator, &position, mv(from, None, to, true)) { "P" } else { "-" }
+                )
+            };
+            println!(
+                "reading2 {set} deferred={deferred}: lance_to_last_rank={} pawn_to_last_rank={} silver_inside_zone={}",
+                choices((0, 10), (0, 11)),
+                choices((1, 10), (1, 11)),
+                choices((2, 9), (2, 10))
+            );
+        }
+    }
+}

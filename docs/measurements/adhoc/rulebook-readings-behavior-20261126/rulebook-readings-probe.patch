+/// 規則書の読みが分かれる箇所について、裁定の順位と後の順位の条件を並べて観測する使い捨ての試験。
+#[cfg(test)]
+mod rulebook_reading_probe {
+    use super::mate::stalemate_or_mate;
+    use super::*;
+    use crate::rules::{Rules, parse_rule_set};
+    use crate::test_util::{position, sq};
+    use crate::{Color, Move, PieceKind};
+
+    fn step(from: (u8, u8), to: (u8, u8)) -> Move {
+        Move {
+            from: sq(from.0, from.1),
+            mid: None,
+            to: sq(to.0, to.1),
+            promote: false,
+        }
+    }
+
+    /// 手順を審判の層の関数で進め、最後の着手の後の本番の裁定と、
+    /// 同じ局面と履歴に対する合法手なしと詰みの判定を表示する。
+    fn run(label: &str, set: &str, mut board: Position, moves: &[Move]) {
+        let rules = Rules::from_codes(&parse_rule_set(set).unwrap()).unwrap();
+        let generator = MoveGenerator::new(rules.moves);
+        let mut state = AdjudicationState::new(rules.repetition, &board);
+        for (index, &played) in moves.iter().enumerate() {
+            let mover = board.side_to_move();
+            let undo = board
+                .try_make_move_with_undo(played, &generator)
+                .expect("the probe plays legal moves");
+            let repetition = state.record_move(&board, &generator, mover, played, &undo);
+            let adjudication = adjudicate_after_move(
+                &mut board,
+                AdjudicationContext::new(rules, &state, &generator),
+                mover,
+                repetition,
+            );
+            state.set_piece_exhaustion_grace(adjudication.piece_exhaustion_grace());
+            if index + 1 == moves.len() || adjudication.result().is_some() {
+                let later = stalemate_or_mate(
+                    &mut board,
+                    &AdjudicationContext::new(rules, &state, &generator),
+                );
+                let side = board.side_to_move();
+                let royals = board.royal_pieces(side);
+                let in_check = royals.into_iter().any(|royal| {
+                    !board
+                        .attackers_to_by(side.opposite(), royal, board.occupied())
+                        .is_empty()
+                });
+                println!(
+                    "{label} {set} ply {}: adjudication={:?} stalemate_or_mate={later:?} side_to_move={side:?} royal_attacked={in_check}",
+                    index + 1,
+                    adjudication.result()
+                );
+                break;
+            }
+        }
+    }
+
+    #[test]
+    fn reading_4_priority_examples() {
+        // 例2: R1が引き分けと裁定する4回目の出現と、手番側の詰み。
+        let example_2 = position(
+            Color::Black,
+            &[
+                (sq(0, 11), Color::Black, PieceKind::King),
+                (sq(4, 5), Color::Black, PieceKind::GoBetween),
+                (sq(6, 4), Color::White, PieceKind::King),
+                (sq(0, 0), Color::White, PieceKind::Rook),
+                (sq(7, 11), Color::White, PieceKind::Rook),
+                (sq(1, 11), Color::White, PieceKind::Kirin),
+                (sq(9, 5), Color::White, PieceKind::GoBetween),
+            ],
+        );
+        let (x, x2, a, b, p, q) = ((4, 5), (4, 6), (9, 5), (9, 6), (0, 11), (1, 10));
+        let mut moves = vec![step(x, x2), step(a, b), step(p, q), step(b, a), step(x2, x)];
+        for _ in 0..2 {
+            moves.extend([step(a, b), step(q, p), step(b, a), step(p, q)]);
+        }
+        moves.extend([step(a, b), step(q, p), step(b, a)]);
+        run("reading4-2", "L0,P0,R1,E2", example_2.clone(), &moves);
+        run("reading4-2", "L0,P0,R1,E0", example_2, &moves);
+
+        // 例3: 駒枯れによる勝ち（E0）と、勝つ側の詰み。論点5の局面でもある。
+        let example_3 = position(
+            Color::White,
+            &[
+                (sq(0, 11), Color::Black, PieceKind::King),
+                (sq(0, 10), Color::Black, PieceKind::Lance),
+                (sq(1, 11), Color::Black, PieceKind::Pawn),
+                (sq(2, 9), Color::Black, PieceKind::Pawn),
+                (sq(1, 10), Color::White, PieceKind::King),
+            ],
+        );
+        for set in ["L0,P0,R1,E0", "L0,P0,R1,E2", "L0,P0,R1,E3"] {
+            run("reading4-3", set, example_3.clone(), &[step((1, 10), (2, 9))]);
+        }
+
+        // 例4: 死に駒を除いて双方が王駒だけになった引き分けと、R2の禁止による合法手なし。
+        let example_4 = position(
+            Color::White,
+            &[
+                (sq(0, 10), Color::Black, PieceKind::King),
+                (sq(1, 11), Color::Black, PieceKind::Pawn),
+                (sq(0, 9), Color::White, PieceKind::King),
+            ],
+        );
+        let (corner, u, q2, w, v, f) = ((0, 11), (0, 10), (1, 10), (0, 9), (1, 9), (0, 8));
+        let sequence = [
+            step(w, v),
+            step(u, w),
+            step(v, f),
+            step(w, v),
+            step(f, w),
+            step(v, q2),
+            step(w, u),
+            step(q2, corner),
+            step(u, w),
+        ];
+        for set in ["L0,P0,R2,E0", "L0,P0,R2,E3", "L0,P0,R2,E2"] {
+            run("reading4-4", set, example_4.clone(), &sequence);
+        }
+    }
+}

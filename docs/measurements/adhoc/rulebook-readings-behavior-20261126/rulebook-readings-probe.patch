+/// 論点4の例1: 裸玉による勝ち（E3）と、相手の合法手なしが同時に成立する局面。
+#[test]
+fn reading_4_bare_king_and_no_legal_move() {
+    for set in ["L1,L2,P0,P3,R1,E1,E3", "L0,P0,R1,E3", "L0,P0,R1,E0", "L0,P0,R1,E2"] {
+        let mut builder = PositionBuilder::new(Color::White);
+        let pieces = [
+            (sq(0, 11), unpromoted(Color::Black, PieceKind::King)),
+            (sq(0, 10), unpromoted(Color::Black, PieceKind::Lance)),
+            (sq(1, 10), unpromoted(Color::Black, PieceKind::Pawn)),
+            (sq(1, 11), unpromoted(Color::Black, PieceKind::Lance)),
+            (sq(5, 5), PieceCode::new_promoted(Color::Black, PieceKind::CrownPrince).unwrap()),
+            (sq(6, 6), unpromoted(Color::White, PieceKind::King)),
+        ];
+        for (square, piece) in pieces {
+            builder.put(square, piece).unwrap();
+        }
+        let chosen = rules(set);
+        let mut game = Game::from_position(chosen, builder.finish().unwrap());
+        let status = game.play(step((6, 6), (5, 5)));
+        let mut moves = Vec::new();
+        MoveGenerator::new(chosen.moves).generate_moves(game.position(), &mut moves);
+        println!("reading4-1 {set}: {status:?} black_legal_moves={}", moves.len());
+    }
+}

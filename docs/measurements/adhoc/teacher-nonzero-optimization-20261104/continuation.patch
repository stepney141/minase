+/// 現在の駒種と到達升を除く、continuation historyの行先頭を返す。
+fn continuation_row_offset(context: MoveRecord, color: Color, distance: usize) -> usize {
+    let context_to = oriented_square(context.mv.to.dense_index(), color);
+    let context_kind = context
+        .piece
+        .kind()
+        .expect("continuation context piece kind")
+        .index();
+    (((usize::from(context.captured.is_some()) * COLOR_COUNT
+        + usize::from(distance.is_multiple_of(2)))
+        * PIECE_KIND_COUNT
+        + context_kind)
+        * BOARD_SQUARE_COUNT
+        + context_to)
+        * PIECE_KIND_COUNT
+        * BOARD_SQUARE_COUNT
+}
+

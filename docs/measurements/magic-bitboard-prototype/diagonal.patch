diff --git a/src/core/attacks/diagonal.rs b/src/core/attacks/diagonal.rs
new file mode 100644
index 0000000..997c6c7
--- /dev/null
+++ b/src/core/attacks/diagonal.rs
@@ -0,0 +1,111 @@
+//! 斜め4方向の占有を64ビットへまとめる乗算式の利き表。
+
+use crate::core::bitboard::Bitboard;
+use crate::core::direction::{Direction, step_square};
+use crate::core::square::{RAW_SQUARE_COUNT, Square};
+
+use super::diagonal_constants::DIAGONAL_MAGICS;
+
+const DIRECTIONS: [Direction; 4] = [
+    Direction::NorthEast,
+    Direction::NorthWest,
+    Direction::SouthEast,
+    Direction::SouthWest,
+];
+
+#[derive(Clone, Copy)]
+struct DiagonalMagic {
+    mask: [u64; 3],
+    factor: u64,
+    offset: usize,
+    shift: u32,
+}
+
+impl DiagonalMagic {
+    fn index(self, occupied: Bitboard) -> usize {
+        let words = occupied.words();
+        let folded =
+            (words[0] & self.mask[0]) | (words[1] & self.mask[1]) | (words[2] & self.mask[2]);
+        self.offset + (folded.wrapping_mul(self.factor) >> self.shift) as usize
+    }
+}
+
+pub(super) struct DiagonalTables {
+    magics: Box<[DiagonalMagic]>,
+    attacks: Box<[Bitboard]>,
+}
+
+impl DiagonalTables {
+    pub(super) fn build() -> Self {
+        // 盤外の生インデックスには到達しない。既存の利き線表と同じ直接添字を使う。
+        let mut magics = vec![
+            DiagonalMagic {
+                mask: [0; 3],
+                factor: 0,
+                offset: 0,
+                shift: 0,
+            };
+            4 * RAW_SQUARE_COUNT
+        ];
+        let mut attacks = Vec::new();
+        for (diagonal, direction) in DIRECTIONS.into_iter().enumerate() {
+            for from in Square::all() {
+                let mut ray = Vec::new();
+                let mut current = from;
+                while let Some(next) = step_square(current, direction) {
+                    ray.push(next);
+                    current = next;
+                }
+                let bits = ray.len().saturating_sub(1);
+                let mask = Bitboard::from_squares(ray[..bits].iter().copied());
+                let magic = DiagonalMagic {
+                    mask: *mask.words(),
+                    factor: DIAGONAL_MAGICS[diagonal][from.dense_index()],
+                    offset: attacks.len(),
+                    shift: if bits == 0 { 0 } else { 64 - bits as u32 },
+                };
+                let size = 1 << bits;
+                attacks.resize(attacks.len() + size, Bitboard::EMPTY);
+                let mut seen = vec![false; size];
+                for subset in 0..size {
+                    let occupied = Bitboard::from_squares(
+                        ray[..bits]
+                            .iter()
+                            .enumerate()
+                            .filter(|(i, _)| subset & (1 << i) != 0)
+                            .map(|(_, square)| *square),
+                    );
+                    let mut attack = Bitboard::EMPTY;
+                    for &square in &ray {
+                        attack.set(square);
+                        if occupied.contains(square) {
+                            break;
+                        }
+                    }
+                    let index = magic.index(occupied);
+                    if seen[index - magic.offset] {
+                        assert_eq!(attacks[index], attack, "invalid diagonal magic");
+                    }
+                    seen[index - magic.offset] = true;
+                    attacks[index] = attack;
+                }
+                magics[diagonal * RAW_SQUARE_COUNT + from.raw_index()] = magic;
+            }
+        }
+        Self {
+            magics: magics.into_boxed_slice(),
+            attacks: attacks.into_boxed_slice(),
+        }
+    }
+
+    #[inline]
+    pub(super) fn control(
+        &self,
+        from: Square,
+        direction: Direction,
+        occupied: Bitboard,
+    ) -> Bitboard {
+        let index = (direction.index() - 4) * RAW_SQUARE_COUNT + from.raw_index();
+        self.attacks[self.magics[index].index(occupied)]
+    }
+}

+//! Offline generator: rustc -O tools/generate_diagonal_magics.rs -o /tmp/generate-diagonal-magics
+//! Run the executable with stdout redirected to src/core/attacks/diagonal_constants.rs.
+//! Each mask gets exactly its relevant occupancy bit count, with no wider-table retry.
+
+use std::time::Instant;
+
+const MAX_TRIALS: u64 = 1_000_000;
+const SEED: u64 = 0x52f1_804b_b57c_183d;
+const DIRECTIONS: [(i32, i32); 4] = [(1, 1), (-1, 1), (1, -1), (-1, -1)];
+
+fn random(state: &mut u64) -> u64 {
+    *state ^= *state >> 12;
+    *state ^= *state << 25;
+    *state ^= *state >> 27;
+    state.wrapping_mul(0x2545_f491_4f6c_dd1d)
+}
+
+fn main() {
+    let start = Instant::now();
+    let mut state = SEED;
+    let mut magics = [[0_u64; 144]; 4];
+    let mut total_trials = 0_u64;
+    let mut maximum_trials = 0_u64;
+    let mut entries = 0_usize;
+    let mut nonempty_masks = 0_usize;
+    for (direction, &(df, dr)) in DIRECTIONS.iter().enumerate() {
+        for square in 0..144 {
+            let (mut file, mut rank) = (square as i32 % 12, square as i32 / 12);
+            let mut ray = Vec::new();
+            loop {
+                file += df;
+                rank += dr;
+                if !(0..12).contains(&file) || !(0..12).contains(&rank) {
+                    break;
+                }
+                ray.push((16 * rank + file) as u32 % 64);
+            }
+            let bits = ray.len().saturating_sub(1);
+            let size = 1 << bits;
+            entries += size;
+            if bits == 0 {
+                continue;
+            }
+            nonempty_masks += 1;
+            let mut occupancy = vec![0_u64; size];
+            let mut reach = vec![0_usize; size];
+            for subset in 0..size {
+                for (i, &bit) in ray[..bits].iter().enumerate() {
+                    if subset & (1 << i) != 0 {
+                        occupancy[subset] |= 1_u64 << bit;
+                    }
+                }
+                reach[subset] = if subset == 0 {
+                    ray.len()
+                } else {
+                    subset.trailing_zeros() as usize + 1
+                };
+            }
+            let mut epoch = vec![0_u64; size];
+            let mut attacks = vec![0_usize; size];
+            let mut success = false;
+            for attempt in 1..=MAX_TRIALS {
+                total_trials += 1;
+                let candidate = random(&mut state) & random(&mut state) & random(&mut state);
+                let mut valid = true;
+                for subset in 0..size {
+                    let index = (occupancy[subset].wrapping_mul(candidate) >> (64 - bits)) as usize;
+                    if epoch[index] == attempt && attacks[index] != reach[subset] {
+                        valid = false;
+                        break;
+                    }
+                    epoch[index] = attempt;
+                    attacks[index] = reach[subset];
+                }
+                if valid {
+                    magics[direction][square] = candidate;
+                    maximum_trials = maximum_trials.max(attempt);
+                    success = true;
+                    break;
+                }
+            }
+            assert!(
+                success,
+                "magic search exhausted: direction={direction}, square={square}, bits={bits}, limit={MAX_TRIALS}, total_trials={total_trials}"
+            );
+        }
+    }
+    println!("// Generated by tools/generate_diagonal_magics.rs; do not edit by hand.");
+    println!("pub(super) const DIAGONAL_MAGICS: [[u64; 144]; 4] = [");
+    for direction in magics {
+        println!("    [");
+        for magic in direction {
+            println!("        0x{magic:016x},");
+        }
+        println!("    ],");
+    }
+    println!("];");
+    eprintln!(
+        "{{\"seed\":\"{SEED:016x}\",\"limit_per_mask\":{MAX_TRIALS},\"successful_masks\":576,\"nonempty_masks\":{nonempty_masks},\"total_trials\":{total_trials},\"maximum_trials\":{maximum_trials},\"entries\":{entries},\"payload_bytes\":{},\"seconds\":{:.6}}}",
+        entries * 24,
+        start.elapsed().as_secs_f64()
+    );
+}

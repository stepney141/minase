+    fn observe_quiet_order(&mut self, position: &Position, pst: &Pst) {
+        let len = self.quiet_order.len();
+        if len == 0 {
+            return;
+        }
+        let observation = &mut self.diag_quiet_observation;
+        observation.quiet_stage_nodes = 1;
+        observation.quiets_total = len as u64;
+        observation.quiets_history_zero =
+            self.quiet_order.iter().filter(|(h, _)| h.0 == 0).count() as u64;
+        let mut candidate: Vec<_> = self
+            .quiet_order
+            .iter()
+            .enumerate()
+            .map(|(rank, &(history, index))| {
+                (
+                    history,
+                    Reverse(pst.quiet_move_pst_delta(position, self.quiets[index])),
+                    index,
+                    rank,
+                )
+            })
+            .collect();
+        candidate.sort_unstable();
+        self.diag_candidate_rank.resize(len, 0);
+        for (rank, &(_, _, _, current)) in candidate.iter().enumerate() {
+            self.diag_candidate_rank[current] = rank;
+        }
+        observation.head_changed = u64::from(self.diag_candidate_rank[0] != 0);
+        self.diag_tie_sizes.resize(len, 0);
+        let mut start = 0;
+        while start < len {
+            let mut end = start + 1;
+            while end < len && self.quiet_order[end].0 == self.quiet_order[start].0 {
+                end += 1;
+            }
+            let size = end - start;
+            self.diag_tie_sizes[start..end].fill(size);
+            let bucket = match size {
+                1 => 0,
+                2..=4 => 1,
+                5..=16 => 2,
+                17..=64 => 3,
+                _ => 4,
+            };
+            observation.tie_groups[bucket] += 1;
+            if size >= 2 {
+                observation.quiets_in_tie_groups_ge2 += size as u64;
+            }
+            start = end;
+        }
+    }

+/// αと例外条件をノード入口で固定し、着手を適用せず読む集合だけを比べる。
+#[cfg(feature = "search-stats")]
+struct QsearchObservation {
+    alpha: i32,
+    stand_pat: i32,
+    delta_margin: i32,
+    previous_capture: Option<minase_core::Square>,
+    royals: Bitboard,
+    royal_count: u32,
+    current: Vec<QsearchCapture>,
+    candidate: Vec<QsearchCapture>,
+}
+
+#[cfg(feature = "search-stats")]
+impl QsearchObservation {
+    fn new(searcher: &mut Searcher<'_>, ply: usize, alpha: i32, stand_pat: i32) -> Self {
+        searcher.ordering_diag.cand3.qnodes += 1;
+        Self {
+            alpha,
+            stand_pat,
+            delta_margin: searcher.delta_margin,
+            previous_capture: searcher.previous_capture[ply],
+            royals: searcher.qsearch[ply].royals,
+            royal_count: searcher.qsearch[ply].royal_count,
+            current: Vec::new(),
+            candidate: Vec::new(),
+        }
+    }
+
+    fn collect_groups(&mut self, searcher: &mut Searcher<'_>, position: &Position, ply: usize) {
+        let buffers = &mut searcher.qsearch[ply];
+        for group in buffers.diag_groups.drain(..) {
+            let current: Vec<_> = group
+                .into_iter()
+                .filter(|c| Some(c.capture.mv) != buffers.tt_move)
+                .collect();
+            // 現行の整列済み列に対する安定整列は、historyを先頭に加えたキーと同値。
+            // 同点時のattacker/origin/seqの順序をそのまま保つ。
+            let mut candidate: Vec<_> = current
+                .iter()
+                .map(|&c| {
+                    (
+                        c,
+                        Reverse(searcher.capture_history.read(
+                            position,
+                            searcher.pst,
+                            c.capture.mv,
+                        )),
+                    )
+                })
+                .collect();
+            candidate.sort_by_key(|&(_, history)| history);
+            if current.len() >= 2 {
+                searcher.ordering_diag.cand3.groups_ge2 += 1;
+                searcher.ordering_diag.cand3.groups_head_changed +=
+                    u64::from(current[0].capture.mv != candidate[0].0.capture.mv);
+            }
+            self.current.extend(current);
+            self.candidate.extend(candidate.into_iter().map(|(c, _)| c));
+        }
+    }
+
+    fn selected(
+        &self,
+        searcher: &Searcher<'_>,
+        position: &Position,
+        candidates: &[QsearchCapture],
+    ) -> Vec<Move> {
+        let mut selected = Vec::new();
+        for candidate in candidates {
+            let mv = candidate.capture.mv;
+            let last_royal =
+                captures_all_royals(self.royals, self.royal_count, candidate.capture.captured);
+            if !last_royal
+                && self.stand_pat + candidate.captured_value + self.delta_margin <= self.alpha
+            {
+                continue;
+            }
+            if !last_royal && capture_is_pruned_by_see(position, searcher.rules, searcher.pst, mv) {
+                continue;
+            }
+            if selected.len() >= params::qsearch_move_limit() as usize
+                && !last_royal
+                && !self
+                    .previous_capture
+                    .is_some_and(|square| candidate.capture.captured.contains(&Some(square)))
+                && !(candidate.capture.piece.kind() == Some(PieceKind::Lion)
+                    && candidate.capture.captured.iter().all(Option::is_some))
+            {
+                continue;
+            }
+            selected.push(mv);
+        }
+        selected
+    }
+
+    fn compare(self, searcher: &mut Searcher<'_>, position: &Position) {
+        let current = self.selected(searcher, position, &self.current);
+        let candidate = self.selected(searcher, position, &self.candidate);
+        searcher.ordering_diag.cand3.nodes_compared += 1;
+        searcher.ordering_diag.cand3.nodes_set_differs += u64::from(
+            current.len() != candidate.len() || current.iter().any(|mv| !candidate.contains(mv)),
+        );
+    }
+}

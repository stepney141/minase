+//! diag-a.mdの加算、影の減点、PST差分、および受動計数の契約。
+
+use super::*;
+use crate::search::alphabeta::capture_history::CaptureHistory;
+use crate::search::alphabeta::ordering_diag::*;
+use crate::search::alphabeta::params;
+
+fn rank_counts(n: u64) -> RankChange {
+    RankChange {
+        count: n,
+        forward: n,
+        backward: n,
+        forward_sum: n,
+        backward_sum: n,
+    }
+}
+
+// 全フィールドを明記し、新しいフィールドが追加されたら試験にも反映させる。
+fn all_counts(n: u64) -> OrderingDiag {
+    OrderingDiag {
+        loop_nodes: Depth([n; 4]),
+        w: Depth(
+            [HeadType(
+                [Work {
+                    count: n,
+                    w_sum: n,
+                    first_move_cutoffs: n,
+                }; 5],
+            ); 4],
+        ),
+        cut_move_type: Depth([CutType([n; 4]); 4]),
+        no_cutoff_nodes: Depth([n; 4]),
+        cutoff_before_quiets: Depth([n; 4]),
+        capture_head: Depth(
+            [CapturePosition(
+                [SeeType(
+                    [CaptureHead {
+                        count: n,
+                        subtree_sum: n,
+                        cut_by_head: n,
+                    }; 2],
+                ); 2],
+            ); 4],
+        ),
+        cand1: Candidate1 {
+            segments: n,
+            segments_changed: n,
+            quiet_cutoff_nodes: n,
+            quiet_cutoff_nodes_with_searched_captures: n,
+            capture_cut_rank: rank_counts(n),
+        },
+        cand2: ShallowDepth(
+            [TtType(
+                [Candidate2 {
+                    zero_window_nodes: n,
+                    head_negative: n,
+                    head_negative_subtree_sum: n,
+                    head_negative_pruned: n,
+                    head_negative_with_killer: n,
+                    head_negative_with_killer_subtree_sum: n,
+                    head_negative_with_killer_cutoff_before_quiets: n,
+                    generate_quiets_calls: n,
+                }; 2],
+            ); 3],
+        ),
+        cand3: Candidate3 {
+            qnodes: n,
+            groups_ge2: n,
+            groups_head_changed: n,
+            nodes_compared: n,
+            nodes_set_differs: n,
+        },
+        cand5: Candidate5 {
+            quiet_stage_nodes: n,
+            head_changed: n,
+            quiets_total: n,
+            quiets_history_zero: n,
+            tie_groups: TieSize([n; 5]),
+            quiets_in_tie_groups_ge2: n,
+            success_moves: QuietSuccess {
+                ranks: rank_counts(n),
+                from_tie_group_ge2: n,
+            },
+        },
+        cost: Cost {
+            see_calls: n,
+            see_ns: n,
+            generate_quiets_calls: n,
+            generate_quiets_ns: n,
+        },
+    }
+}
+
+#[test]
+fn add_assign_sums_every_counter_and_serializes_named_buckets() {
+    let mut sum = all_counts(2);
+    sum += all_counts(7);
+    assert_eq!(sum, all_counts(9));
+    let before = sum;
+    sum += OrderingDiag::default();
+    assert_eq!(sum, before);
+    let json = serde_json::to_value(sum).unwrap();
+    assert_eq!(json["w"]["4+"]["capture_see_negative"]["w_sum"], 9);
+    assert_eq!(json["capture_head"]["2"]["after_tt"]["other"]["count"], 9);
+    assert_eq!(json["cand2"]["3"]["no_tt"]["head_negative_pruned"], 9);
+    assert!(json["cand2"].get("4+").is_none());
+    assert_eq!(json["cand5"]["tie_groups"]["65+"], 9);
+    assert_eq!(json["cand5"]["success_moves"]["count"], 9);
+}
+
+fn capture_board() -> Position {
+    position(
+        Color::Black,
+        &[
+            (sq(0, 0), Color::Black, PieceKind::King),
+            (sq(11, 11), Color::White, PieceKind::King),
+            (sq(5, 5), Color::Black, PieceKind::Rook),
+            (sq(5, 7), Color::White, PieceKind::Pawn),
+            (sq(3, 5), Color::White, PieceKind::Pawn),
+            (sq(7, 5), Color::White, PieceKind::Pawn),
+            (sq(5, 3), Color::White, PieceKind::Pawn),
+        ],
+    )
+}
+
+#[test]
+fn quiet_cutoff_penalty_updates_only_earlier_captures_with_gravity_and_limit() {
+    let board = capture_board();
+    let pst = weights().unwrap();
+    let captures: Vec<_> = legal_moves(&board)
+        .into_iter()
+        .filter(|&mv| move_order_key(&board, &pst, mv).is_some())
+        .collect();
+    assert_eq!(captures.len(), 4);
+    for depth in [0, 1, 3, 256, 300] {
+        let mut history = CaptureHistory::new();
+        history.record_cutoff(&board, &pst, captures[0], &[captures[1]], 100);
+        let before: Vec<_> = captures
+            .iter()
+            .map(|&mv| history.read(&board, &pst, mv))
+            .collect();
+        history.record_quiet_cutoff_penalty(&board, &pst, &captures[..2], depth);
+        let limit = i64::from(params::capture_history_limit());
+        let penalty = i64::from(depth * depth).min(limit);
+        for (i, &mv) in captures.iter().enumerate() {
+            let old = i64::from(before[i]);
+            let expected = if i < 2 {
+                old - penalty - old * penalty / limit
+            } else {
+                old
+            };
+            assert_eq!(i64::from(history.read(&board, &pst, mv)), expected);
+        }
+        let after: Vec<_> = captures
+            .iter()
+            .map(|&mv| history.read(&board, &pst, mv))
+            .collect();
+        history.record_quiet_cutoff_penalty(&board, &pst, &[], depth);
+        assert_eq!(
+            after,
+            captures
+                .iter()
+                .map(|&mv| history.read(&board, &pst, mv))
+                .collect::<Vec<_>>()
+        );
+    }
+}
+
+#[test]
+fn quiet_pst_delta_matches_full_accumulator_difference_for_both_sides_and_promotions() {
+    let pst = weights().unwrap();
+    let mut promotions = 0;
+    let mut stationary = 0;
+    for side in Color::ALL {
+        let sparse = position(
+            side,
+            &[
+                (sq(0, 0), Color::Black, PieceKind::King),
+                (sq(11, 11), Color::White, PieceKind::King),
+                (sq(3, 7), Color::Black, PieceKind::Rook),
+                (sq(8, 4), Color::White, PieceKind::Rook),
+                (sq(5, 5), side, PieceKind::Lion),
+            ],
+        );
+        let mut initial = Position::initial();
+        if side == Color::White {
+            initial.make_null_move();
+        }
+        for mut board in [sparse, initial] {
+            let before = pst.accumulator_numerator_for_test(&board, side);
+            for mv in legal_moves(&board) {
+                if board.captured_squares(mv).iter().any(Option::is_some) {
+                    continue;
+                }
+                promotions += usize::from(mv.promote);
+                stationary += usize::from(mv.from == mv.to);
+                let delta = pst.quiet_move_pst_delta(&board, mv);
+                let undo = board.make_move_unchecked(mv, engine_rules());
+                assert_eq!(
+                    delta,
+                    pst.accumulator_numerator_for_test(&board, side) - before,
+                    "{mv:?}"
+                );
+                board.unmake_move(undo);
+            }
+        }
+    }
+    assert!(promotions > 0);
+    assert!(stationary > 0);
+}
+
+/// 子局面を既知の値に固定し、Wがカット手を含まず探索済み手だけを数えることを検査する。
+#[test]
+fn work_and_shadow_penalty_follow_the_observed_cutoff() {
+    let board = capture_board();
+    for quiet_cutoff in [false, true] {
+        with_root_searcher(&board, &[], |searcher| {
+            let mut picker = MovePicker::new(None, [None; KILLER_COUNT]);
+            let moves: Vec<_> = std::iter::from_fn(|| {
+                picker.next(
+                    &board,
+                    searcher.pst,
+                    &searcher.generator,
+                    searcher.history,
+                    &searcher.capture_history,
+                )
+            })
+            .collect();
+            let winner_index = if quiet_cutoff { 4 } else { 2 };
+            for (index, &(mv, _)) in moves.iter().enumerate() {
+                let mut child = board.clone();
+                child.make_move_unchecked(mv, engine_rules());
+                let score = if index == winner_index { 20 } else { 0 };
+                searcher
+                    .tt
+                    .store(search_key(&child), 1, -score, Bound::Exact, None, 1);
+            }
+            assert_eq!(
+                searcher.negamax(&mut board.clone(), 2, -10, 10, 0),
+                Some(20)
+            );
+            let diag = searcher.ordering_diag;
+            assert_eq!(diag.loop_nodes[1], 1);
+            assert_eq!(diag.no_cutoff_nodes[1], 0);
+            assert_eq!(diag.w[1].0.iter().map(|w| w.count).sum::<u64>(), 1);
+            assert_eq!(
+                diag.w[1].0.iter().map(|w| w.w_sum).sum::<u64>(),
+                winner_index as u64
+            );
+            assert_eq!(diag.cand1.segments, 1);
+            assert_eq!(diag.cand1.segments_changed, 0);
+            assert_eq!(diag.cand1.quiet_cutoff_nodes, u64::from(quiet_cutoff));
+            assert_eq!(
+                diag.cand1.quiet_cutoff_nodes_with_searched_captures,
+                u64::from(quiet_cutoff)
+            );
+            for (index, &(mv, capture)) in moves.iter().enumerate() {
+                if capture {
+                    let expected = if index < winner_index {
+                        -4
+                    } else if index == winner_index {
+                        4
+                    } else {
+                        0
+                    };
+                    assert_eq!(
+                        searcher
+                            .shadow_capture_history
+                            .read(&board, searcher.pst, mv),
+                        expected
+                    );
+                }
+            }
+        });
+    }
+}
+
+/// 手数制限の外の捕獲を群の先頭へ動かすと集合が変わる。TT直後のカットでも残りの群を比べる。
+#[test]
+fn qsearch_compares_unread_groups_and_resets_diagnostic_buffers() {
+    let count = params::qsearch_move_limit() as u8 + 1;
+    let mut pieces = vec![
+        (sq(11, 0), Color::Black, PieceKind::King),
+        (sq(11, 11), Color::White, PieceKind::King),
+    ];
+    let mut captures = Vec::new();
+    for file in 0..count {
+        pieces.push((sq(file, 4), Color::Black, PieceKind::Pawn));
+        pieces.push((sq(file, 5), Color::White, PieceKind::Pawn));
+        captures.push(Move {
+            from: sq(file, 4),
+            to: sq(file, 5),
+            mid: None,
+            promote: false,
+        });
+    }
+    let board = position(Color::Black, &pieces);
+    for early_cutoff in [false, true] {
+        with_root_searcher(&board, &[], |searcher| {
+            let ply = MAX_PLY - 1;
+            searcher.capture_history.record_cutoff(
+                &board,
+                searcher.pst,
+                *captures.last().unwrap(),
+                &[],
+                4,
+            );
+            let stand_pat = evaluate(searcher.pst, &board);
+            let beta = if early_cutoff {
+                stand_pat + 1
+            } else {
+                INFINITY
+            };
+            for _ in 0..2 {
+                searcher.tt.store(
+                    search_key(&board),
+                    0,
+                    INFINITY,
+                    Bound::Upper,
+                    early_cutoff.then_some(captures[0]),
+                    ply,
+                );
+                let before = searcher.ordering_diag.cand3;
+                let before_nodes = searcher.nodes;
+                let score = searcher
+                    .quiesce(&mut board.clone(), -INFINITY, beta, ply)
+                    .unwrap();
+                let after = searcher.ordering_diag.cand3;
+                assert_eq!(after.qnodes - before.qnodes, 1);
+                assert_eq!(after.groups_ge2 - before.groups_ge2, 1);
+                assert_eq!(after.groups_head_changed - before.groups_head_changed, 1);
+                assert_eq!(after.nodes_compared - before.nodes_compared, 1);
+                assert_eq!(after.nodes_set_differs - before.nodes_set_differs, 1);
+                if early_cutoff {
+                    assert!(score >= beta);
+                    assert_eq!(searcher.nodes - before_nodes, 1);
+                }
+            }
+        });
+    }
+}
+
+/// TT後のSEE枝刈りは捕獲先頭の費用へ入れず、TTと同じkillerも候補2から除く。
+#[test]
+fn candidate2_excludes_pruned_head_cost_and_tt_killer() {
+    let board = position(
+        Color::Black,
+        &[
+            (sq(11, 0), Color::Black, PieceKind::King),
+            (sq(0, 11), Color::White, PieceKind::King),
+            (sq(5, 3), Color::Black, PieceKind::FreeKing),
+            (sq(5, 4), Color::White, PieceKind::Rook),
+            (sq(5, 5), Color::White, PieceKind::Pawn),
+            (sq(3, 3), Color::Black, PieceKind::Pawn),
+            (sq(3, 4), Color::White, PieceKind::Pawn),
+        ],
+    );
+    let quiet = Move {
+        from: sq(11, 0),
+        to: sq(10, 0),
+        mid: None,
+        promote: false,
+    };
+    let winner = Move {
+        from: sq(3, 3),
+        to: sq(3, 4),
+        mid: None,
+        promote: false,
+    };
+    for distinct_killer in [false, true] {
+        with_root_searcher(&board, &[], |searcher| {
+            let killer = if distinct_killer {
+                legal_moves(&board)
+                    .into_iter()
+                    .find(|&mv| mv != quiet && move_order_key(&board, searcher.pst, mv).is_none())
+                    .unwrap()
+            } else {
+                quiet
+            };
+            searcher.killers[0][0] = Some(killer);
+            searcher
+                .tt
+                .store(search_key(&board), 0, 0, Bound::Upper, Some(quiet), 0);
+            for (mv, score) in [(quiet, 0), (winner, 10_001)] {
+                let mut child = board.clone();
+                child.make_move_unchecked(mv, engine_rules());
+                searcher
+                    .tt
+                    .store(search_key(&child), 2, -score, Bound::Exact, None, 1);
+            }
+            searcher.null_move_ply = Some(0);
+            assert_eq!(
+                searcher.negamax(&mut board.clone(), 3, 10_000, 10_001, 0),
+                Some(10_001)
+            );
+            let diag = searcher.ordering_diag;
+            assert_eq!(diag.cand2[2][0].zero_window_nodes, 0);
+            let counts = diag.cand2[2][1];
+            assert_eq!(counts.zero_window_nodes, 1);
+            assert_eq!(counts.head_negative, 1);
+            assert_eq!(counts.head_negative_pruned, 1);
+            assert_eq!(counts.head_negative_subtree_sum, 0);
+            assert_eq!(counts.head_negative_with_killer_subtree_sum, 0);
+            assert_eq!(counts.generate_quiets_calls, 1);
+            assert_eq!(counts.head_negative_with_killer, u64::from(distinct_killer));
+            assert_eq!(
+                counts.head_negative_with_killer_cutoff_before_quiets,
+                u64::from(distinct_killer)
+            );
+            assert_eq!(diag.w[2][0].w_sum, 1);
+            assert_eq!(diag.capture_head[2][1][0].count, 0);
+            assert!(!searcher.move_pickers[0].quiets_generated());
+        });
+    }
+}

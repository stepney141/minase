+//! diag-b.mdの初期化、根ごとの減衰、参照元と飽和加算の契約。
+
+use super::*;
+use crate::search::HistoryTables;
+use crate::search::alphabeta::ordering_diag::{
+    CarryCounts, OrderingCarry, carry_index, move_record,
+};
+use crate::search::alphabeta::params;
+
+#[test]
+fn clear_zeroes_all_carried_tables_and_game_counts_without_reallocation() {
+    let mut histories = HistoryTables::new(worker_count(2));
+    let mut pointers = Vec::new();
+    for carry in &mut histories.carry {
+        carry.capture_history.values_for_test().fill(-65_536);
+        carry.counter.fill(16_384);
+        carry.continuation.fill(-16_384);
+        carry.counts = populated_counts(7);
+        pointers.push((carry.counter.as_ptr(), carry.continuation.as_ptr()));
+    }
+    histories.clear();
+    for (carry, pointers) in histories.carry.iter_mut().zip(pointers) {
+        assert!(
+            carry
+                .capture_history
+                .values_for_test()
+                .iter()
+                .all(|&v| v == 0)
+        );
+        assert!(carry.counter.iter().all(|&v| v == 0));
+        assert!(carry.continuation.iter().all(|&v| v == 0));
+        assert_eq!(carry.counts, CarryCounts::default());
+        assert_eq!(
+            (carry.counter.as_ptr(), carry.continuation.as_ptr()),
+            pointers
+        );
+    }
+}
+
+#[test]
+fn root_start_decays_all_three_tables_once_per_worker_without_decaying_counts() {
+    let snapshot = snapshot_for(&Position::initial());
+    let mut histories = HistoryTables::new(worker_count(2));
+    let values: [i16; 7] = [-16_384, -101, -1, 0, 1, 101, 16_384];
+    for carry in &mut histories.carry {
+        for (i, value) in carry
+            .capture_history
+            .values_for_test()
+            .iter_mut()
+            .enumerate()
+        {
+            *value = i32::from(values[i % values.len()]);
+        }
+        for table in [&mut carry.counter, &mut carry.continuation] {
+            for (i, value) in table.iter_mut().enumerate() {
+                *value = values[i % values.len()];
+            }
+        }
+        carry.counts = populated_counts(7);
+    }
+    let pointers: Vec<_> = histories.carry.iter().map(|c| c.counter.as_ptr()).collect();
+    let result = run_search_team(
+        &weights().unwrap(),
+        &snapshot.position,
+        snapshot.rules,
+        &snapshot.root_moves,
+        &snapshot.history_keys,
+        &depth_limits(3),
+        &AtomicBool::new(true),
+        worker_count(2),
+        &small_tt(),
+        &mut histories,
+        None,
+        Instant::now(),
+        &AtomicU64::new(0),
+        false,
+    );
+    assert_eq!(result.result.nodes, 0);
+    let expected = values.map(|v| i32::from(v) * params::history_decay() / 100);
+    for (worker, carry) in histories.carry.iter_mut().enumerate() {
+        for (i, value) in carry.capture_history.values_for_test().iter().enumerate() {
+            assert_eq!(*value, expected[i % expected.len()]);
+        }
+        for table in [&carry.counter, &carry.continuation] {
+            for (i, value) in table.iter().enumerate() {
+                assert_eq!(i32::from(*value), expected[i % expected.len()]);
+            }
+        }
+        let mut counts = populated_counts(7);
+        counts.searches += u64::from(worker == 0);
+        assert_eq!(carry.counts, counts);
+        assert_eq!(carry.counter.as_ptr(), pointers[worker]);
+    }
+}
+
+#[test]
+fn quiet_cutoff_uses_independent_sources_and_saturates_without_halving() {
+    let mut carry = OrderingCarry::new();
+    let source = (28, 143);
+    let reply = (0, 0);
+    let index = carry_index(source, reply);
+    carry.counter[index] = 16_380;
+    carry.counter[index + 1] = 10_000;
+    carry.continuation[index] = -16_384;
+    carry.record_quiet_cutoff(None, None, reply, 3);
+    assert_eq!(carry.counter[index], 16_380);
+    assert_eq!(carry.continuation[index], -16_384);
+    carry.record_quiet_cutoff(None, Some(source), reply, 3);
+    assert_eq!(carry.counter[index], 16_380);
+    assert_eq!(carry.continuation[index], -16_375);
+    carry.record_quiet_cutoff(Some(source), None, reply, 3);
+    assert_eq!(carry.counter[index], 16_384);
+    assert_eq!(carry.counter[index + 1], 10_000);
+    assert_eq!(carry.continuation[index], -16_375);
+    carry.counter[index] = 0;
+    carry.record_quiet_cutoff(Some(source), None, reply, 3);
+    assert_eq!(carry.counter[index], 9);
+    carry.record_quiet_cutoff(Some(source), Some(source), reply, MAX_PLY);
+    assert_eq!(carry.counter[index], 16_384);
+    assert_eq!(carry.continuation[index], 16_384);
+    assert_eq!(carry_index((28, 143), (28, 143)), 29 * 144 * 29 * 144 - 1);
+}
+
+#[test]
+fn search_records_moves_and_clears_null_record_with_independent_ply_sources() {
+    let board = Position::initial();
+    with_root_searcher(&board, &[], |searcher| {
+        assert!(searcher.move_records.iter().all(Option::is_none));
+        let mut carry = OrderingCarry::new();
+        // 参照の添字と更新を同じSearcherで検査する。
+        let first = legal_moves(&board)[0];
+        let record = move_record(&board, first);
+        assert!(
+            searcher
+                .search_move(
+                    &mut board.clone(),
+                    first,
+                    1,
+                    -INFINITY,
+                    INFINITY,
+                    0,
+                    true,
+                    0
+                )
+                .is_some()
+        );
+        assert_eq!(searcher.move_records[0], None);
+        assert_eq!(searcher.move_records[1], Some(record));
+        assert_eq!(searcher.carry_sources(1), [None, None]);
+        assert_eq!(searcher.carry_sources(2), [Some(record), None]);
+        searcher.move_records[2] = Some((28, 143));
+        let mut child = board.clone();
+        child.make_move_unchecked(first, engine_rules());
+        assert!(
+            searcher
+                .search_null_move(&mut child, 0, INFINITY, 1)
+                .is_some()
+        );
+        assert_eq!(searcher.move_records[2], None);
+        assert_eq!(searcher.carry_sources(3), [None, Some(record)]);
+        let [counter, continuation] = searcher.carry_sources(3);
+        carry.record_quiet_cutoff(counter, continuation, record, 4);
+        assert_eq!(carry.counter[carry_index(record, record)], 0);
+        assert_eq!(carry.continuation[carry_index(record, record)], 16);
+    });
+}
+
+fn populated_counts(n: u64) -> CarryCounts {
+    CarryCounts {
+        searches: n,
+        ch_segments: n,
+        ch_segments_changed: n,
+        ch_cut_count: n,
+        ch_cut_forward: n,
+        ch_cut_backward: n,
+        ch_cut_forward_sum: n,
+        ch_cut_backward_sum: n,
+        ch_refs: n,
+        ch_nonzero: n,
+        cmh_nodes: n,
+        cmh_nodes_with_record: n,
+        cmh_refs: n,
+        cmh_nonzero: n,
+        cmh_order_changed: n,
+        cont_nodes: n,
+        cont_nodes_with_record: n,
+        cont_refs: n,
+        cont_nonzero: n,
+        cont_order_changed: n,
+    }
+}
+
+#[test]
+fn sums_all_workers_and_writes_exact_game_keys() {
+    let mut histories = HistoryTables::new(worker_count(2));
+    histories.carry[0].counts = populated_counts(2);
+    histories.carry[1].counts = populated_counts(3);
+    let counts = histories.carry_counts();
+    assert_eq!(counts, populated_counts(5));
+    let mut output = Vec::new();
+    counts.write_info(&mut output).unwrap();
+    let output = String::from_utf8(output).unwrap();
+    let keys = "searches ch_segments ch_segments_changed ch_cut_count ch_cut_forward ch_cut_backward ch_cut_forward_sum ch_cut_backward_sum ch_refs ch_nonzero cmh_nodes cmh_nodes_with_record cmh_refs cmh_nonzero cmh_order_changed cont_nodes cont_nodes_with_record cont_refs cont_nonzero cont_order_changed";
+    assert_eq!(
+        output,
+        format!(
+            "info string diag scope=game {}\n",
+            keys.split_whitespace()
+                .map(|k| format!("{k}=5"))
+                .collect::<Vec<_>>()
+                .join(" ")
+        )
+    );
+}

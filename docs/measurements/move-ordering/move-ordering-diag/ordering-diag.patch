+/// 候補4・6の対局内累計。USIのキーと同じ名前で保持する。
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+pub(crate) struct CarryCounts {
+    pub searches: u64,
+    pub ch_segments: u64,
+    pub ch_segments_changed: u64,
+    pub ch_cut_count: u64,
+    pub ch_cut_forward: u64,
+    pub ch_cut_backward: u64,
+    pub ch_cut_forward_sum: u64,
+    pub ch_cut_backward_sum: u64,
+    pub ch_refs: u64,
+    pub ch_nonzero: u64,
+    pub cmh_nodes: u64,
+    pub cmh_nodes_with_record: u64,
+    pub cmh_refs: u64,
+    pub cmh_nonzero: u64,
+    pub cmh_order_changed: u64,
+    pub cont_nodes: u64,
+    pub cont_nodes_with_record: u64,
+    pub cont_refs: u64,
+    pub cont_nonzero: u64,
+    pub cont_order_changed: u64,
+}
+
+macro_rules! carry_fields {
+    ($($field:ident),+ $(,)?) => {
+        impl AddAssign for CarryCounts {
+            fn add_assign(&mut self, rhs: Self) { $(self.$field += rhs.$field;)+ }
+        }
+        impl CarryCounts {
+            pub(crate) fn write_info(&self, output: &mut dyn std::io::Write) -> std::io::Result<()> {
+                write!(output, "info string diag scope=game")?;
+                $(write!(output, " {}={}", stringify!($field), self.$field)?;)+
+                writeln!(output)
+            }
+        }
+    };
+}
+carry_fields!(
+    searches,
+    ch_segments,
+    ch_segments_changed,
+    ch_cut_count,
+    ch_cut_forward,
+    ch_cut_backward,
+    ch_cut_forward_sum,
+    ch_cut_backward_sum,
+    ch_refs,
+    ch_nonzero,
+    cmh_nodes,
+    cmh_nodes_with_record,
+    cmh_refs,
+    cmh_nonzero,
+    cmh_order_changed,
+    cont_nodes,
+    cont_nodes_with_record,
+    cont_refs,
+    cont_nonzero,
+    cont_order_changed,
+);
+
+use super::capture_history::CaptureHistory;
+use minase_core::board::BOARD_SQUARE_COUNT;
+use minase_core::piece::PIECE_KIND_COUNT;
+
+const MOVE_RECORD_COUNT: usize = PIECE_KIND_COUNT * BOARD_SQUARE_COUNT;
+
+/// ワーカーごとに根の探索をまたいで保持する影の表。
+pub(crate) struct OrderingCarry {
+    pub(super) capture_history: CaptureHistory,
+    pub(super) counter: Box<[i16]>,
+    pub(super) continuation: Box<[i16]>,
+    pub(crate) counts: CarryCounts,
+}
+
+impl OrderingCarry {
+    pub(super) fn new() -> Self {
+        Self {
+            capture_history: CaptureHistory::new(),
+            counter: vec![0; MOVE_RECORD_COUNT * MOVE_RECORD_COUNT].into_boxed_slice(),
+            continuation: vec![0; MOVE_RECORD_COUNT * MOVE_RECORD_COUNT].into_boxed_slice(),
+            counts: CarryCounts::default(),
+        }
+    }
+
+    pub(super) fn clear(&mut self) {
+        self.decay(0);
+        self.counts = CarryCounts::default();
+    }
+
+    pub(super) fn decay(&mut self, decay: i32) {
+        self.capture_history.decay(decay);
+        for value in self.counter.iter_mut().chain(self.continuation.iter_mut()) {
+            *value = (i32::from(*value) * decay / 100) as i16;
+        }
+    }
+
+    pub(super) fn record_quiet_cutoff(
+        &mut self,
+        counter_source: Option<(usize, usize)>,
+        continuation_source: Option<(usize, usize)>,
+        reply: (usize, usize),
+        depth: u32,
+    ) {
+        for (table, source) in [
+            (&mut self.counter, counter_source),
+            (&mut self.continuation, continuation_source),
+        ] {
+            if let Some(source) = source {
+                let value = &mut table[carry_index(source, reply)];
+                *value = (i32::from(*value) + (depth * depth) as i32).clamp(-16_384, 16_384) as i16;
+            }
+        }
+    }
+}
+
+pub(super) fn carry_index(source: (usize, usize), reply: (usize, usize)) -> usize {
+    (source.0 * BOARD_SQUARE_COUNT + source.1) * MOVE_RECORD_COUNT
+        + reply.0 * BOARD_SQUARE_COUNT
+        + reply.1
+}
+
+pub(super) fn move_record(position: &Position, mv: Move) -> (usize, usize) {
+    (
+        position
+            .piece_at(mv.from)
+            .expect("moving piece")
+            .kind()
+            .expect("moving kind")
+            .index(),
+        mv.to.dense_index(),
+    )
+}
+
+impl Searcher<'_> {
+    /// 指示書のply−1、ply−2を独立に参照する。根の記録は常に空。
+    pub(super) fn carry_sources(&self, ply: usize) -> [Option<(usize, usize)>; 2] {
+        [1, 2].map(|offset| ply.checked_sub(offset).and_then(|p| self.move_records[p]))
+    }
+
+    fn observe_carry_quiets(&mut self, position: &Position, ply: usize) {
+        let sources = self.carry_sources(ply);
+        let Some(carry) = self.carry.as_deref_mut() else {
+            return;
+        };
+        let picker = &self.move_pickers[ply];
+        let counts = &mut carry.counts;
+        for (table, source, nodes, with_record, refs, nonzero, changed) in [
+            (
+                &carry.counter,
+                sources[0],
+                &mut counts.cmh_nodes,
+                &mut counts.cmh_nodes_with_record,
+                &mut counts.cmh_refs,
+                &mut counts.cmh_nonzero,
+                &mut counts.cmh_order_changed,
+            ),
+            (
+                &carry.continuation,
+                sources[1],
+                &mut counts.cont_nodes,
+                &mut counts.cont_nodes_with_record,
+                &mut counts.cont_refs,
+                &mut counts.cont_nonzero,
+                &mut counts.cont_order_changed,
+            ),
+        ] {
+            *nodes += 1;
+            let Some(source) = source else { continue };
+            *with_record += 1;
+            let mut candidate: Vec<_> = picker
+                .diag_quiet_order()
+                .iter()
+                .map(|&(history, index)| {
+                    let mv = picker.diag_quiets()[index];
+                    let value = table[carry_index(source, move_record(position, mv))];
+                    *refs += 1;
+                    *nonzero += u64::from(value != 0);
+                    (Reverse(history.0 + i32::from(value)), index)
+                })
+                .collect();
+            candidate.sort_unstable();
+            *changed += u64::from(
+                !candidate
+                    .iter()
+                    .map(|x| x.1)
+                    .eq(picker.diag_quiet_order().iter().map(|x| x.1)),
+            );
+        }
+    }
+}

+//! 手の順序付けの受動診断。表はワーカー内だけで更新し、探索終了後に合算する。
+
+use core::ops::{AddAssign, Index, IndexMut};
+use serde::Serialize;
+
+// 名前付きの固定長表により、ゼロ件の区分もJSONへ出力する。
+macro_rules! table {
+    ($name:ident, $n:expr, [$($key:literal),+]) => {
+        #[doc = "診断区分ごとの固定長表。JSONでは区分名をキーにする。"]
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub struct $name<T>(pub [T; $n]);
+        impl<T: Default> Default for $name<T> {
+            fn default() -> Self { Self(core::array::from_fn(|_| T::default())) }
+        }
+        impl<T: AddAssign> AddAssign for $name<T> {
+            fn add_assign(&mut self, rhs: Self) {
+                for (left, right) in self.0.iter_mut().zip(rhs.0) { *left += right; }
+            }
+        }
+        impl<T> Index<usize> for $name<T> {
+            type Output = T;
+            fn index(&self, i: usize) -> &T { &self.0[i] }
+        }
+        impl<T> IndexMut<usize> for $name<T> {
+            fn index_mut(&mut self, i: usize) -> &mut T { &mut self.0[i] }
+        }
+        impl<T: Serialize> Serialize for $name<T> {
+            fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                use serde::ser::SerializeMap;
+                let mut map = serializer.serialize_map(Some($n))?;
+                for (key, value) in [$($key),+].iter().zip(&self.0) { map.serialize_entry(key, value)?; }
+                map.end()
+            }
+        }
+    };
+}
+table!(Depth, 4, ["1", "2", "3", "4+"]);
+table!(ShallowDepth, 3, ["1", "2", "3"]);
+table!(
+    HeadType,
+    5,
+    [
+        "tt",
+        "capture_see_negative",
+        "capture_other",
+        "killer",
+        "quiet"
+    ]
+);
+table!(CutType, 4, ["tt", "capture", "killer", "quiet"]);
+table!(CapturePosition, 2, ["node_head", "after_tt"]);
+table!(SeeType, 2, ["negative", "other"]);
+table!(TtType, 2, ["no_tt", "tt"]);
+table!(TieSize, 5, ["1", "2-4", "5-16", "17-64", "65+"]);
+
+macro_rules! counters {
+    ($(#[$meta:meta])* $name:ident { $($(#[$field_meta:meta])* $field:ident: $ty:ty),* $(,)? }) => {
+        $(#[$meta])*
+        #[derive(Clone, Copy, Default, Debug, PartialEq, Eq, Serialize)]
+        pub struct $name { $($(#[$field_meta])* pub $field: $ty),* }
+        impl AddAssign for $name {
+            fn add_assign(&mut self, rhs: Self) { $(self.$field += rhs.$field;)* }
+        }
+    };
+}
+counters! {
+    /// 順序付け診断の全計数。残り深さはIIR適用後で分類する。
+    OrderingDiag {
+        /// 通常探索の手のループへ入ったノード数。
+        loop_nodes: Depth<u64>,
+        /// βカットの件数、先行費用、先頭手によるカット数。
+        w: Depth<HeadType<Work>>,
+        /// カット手の出所別件数。
+        cut_move_type: Depth<CutType<u64>>,
+        /// ループを完走したノード数。
+        no_cutoff_nodes: Depth<u64>,
+        /// 静かな手を生成する前にβカットしたノード数。
+        cutoff_before_quiets: Depth<u64>,
+        /// 探索された捕獲段の先頭の費用。
+        capture_head: Depth<CapturePosition<SeeType<CaptureHead>>>,
+        /// 静かな手による捕獲履歴の減点。
+        cand1: Candidate1,
+        /// SEE負の先頭捕獲と合法killerの共存。
+        cand2: ShallowDepth<TtType<Candidate2>>,
+        /// 静止探索の群内への捕獲履歴適用。
+        cand3: Candidate3,
+        /// 静かな手のPST差分による同点破り。
+        cand5: Candidate5,
+        /// 候補2の費用見積りに使う、診断で呼んだSEEと静かな手の生成の所要時間。
+        cost: Cost,
+    }
+}
+counters! {
+    /// 捕獲段の先頭のSEE判定とkiller合法性のための静かな手の生成の回数と所要ナノ秒。
+    Cost {
+        /// `see_prunes(…, 0)`の呼び出し回数。
+        see_calls: u64,
+        /// 同、所要ナノ秒の合計。
+        see_ns: u64,
+        /// `generate_quiets`の呼び出し回数。
+        generate_quiets_calls: u64,
+        /// 同、所要ナノ秒の合計。
+        generate_quiets_ns: u64,
+    }
+}
+counters! {
+    /// βカットまでの先行費用。
+    Work {
+        /// βカットしたノード数。
+        count: u64,
+        /// カット手より前に探索した部分木ノード数の和。
+        w_sum: u64,
+        /// 先頭手自身のβカット数。
+        first_move_cutoffs: u64,
+    }
+}
+counters! {
+    /// 捕獲段の先頭の探索費用。
+    CaptureHead {
+        /// 探索した件数。
+        count: u64,
+        /// 当該捕獲手だけの部分木ノード数の和。
+        subtree_sum: u64,
+        /// 当該捕獲手によるβカット数。
+        cut_by_head: u64,
+    }
+}
+counters! {
+    /// 現行順位から候補順位への変化。
+    RankChange {
+        /// 比較した成功手の数。
+        count: u64,
+        /// 候補の方が前の件数。
+        forward: u64,
+        /// 候補の方が後の件数。
+        backward: u64,
+        /// 前進幅の和。
+        forward_sum: u64,
+        /// 後退幅の和。
+        backward_sum: u64,
+    }
+}
+impl RankChange {
+    pub(super) fn record(&mut self, current: usize, candidate: usize) {
+        self.count += 1;
+        if current > candidate {
+            self.forward += 1;
+            self.forward_sum += (current - candidate) as u64;
+        } else if current < candidate {
+            self.backward += 1;
+            self.backward_sum += (candidate - current) as u64;
+        }
+    }
+}
+counters! {
+    /// 候補1の発動と更新機会。
+    Candidate1 {
+        /// TT手を除いた捕獲候補が2手以上の段数。
+        segments: u64,
+        /// 影の表で手の列が変わる段数。
+        segments_changed: u64,
+        /// 静かな手によるβカット数。
+        quiet_cutoff_nodes: u64,
+        /// 先に探索した捕獲手がある静かな手のβカット数。
+        quiet_cutoff_nodes_with_searched_captures: u64,
+        /// 捕獲段のカット手の順位変化。
+        capture_cut_rank: RankChange,
+    }
+}
+counters! {
+    /// 候補2の対象となる零窓ノード。
+    Candidate2 {
+        /// 手のループに入った対象ノード数。
+        zero_window_nodes: u64,
+        /// 捕獲段の先頭がSEE負だった数。
+        head_negative: u64,
+        /// SEE負の先頭捕獲の部分木ノード数。
+        head_negative_subtree_sum: u64,
+        /// SEE負の先頭捕獲が枝刈りされた数。
+        head_negative_pruned: u64,
+        /// SEE負の先頭捕獲と合法killerが共存した数。
+        head_negative_with_killer: u64,
+        /// 合法killerが共存した先頭捕獲の部分木ノード数。
+        head_negative_with_killer_subtree_sum: u64,
+        /// 合法killerが共存し、静かな手の生成前にカットした数。
+        head_negative_with_killer_cutoff_before_quiets: u64,
+        /// killer合法性のための追加生成回数。
+        generate_quiets_calls: u64,
+    }
+}
+counters! {
+    /// 候補3の群内順序と読む集合の比較。
+    Candidate3 {
+        /// 静止探索の手のループに入ったノード数。
+        qnodes: u64,
+        /// TT手を除いて2候補以上の群数。
+        groups_ge2: u64,
+        /// 群の先頭が変わる数。
+        groups_head_changed: u64,
+        /// 固定αで集合を比較したノード数。
+        nodes_compared: u64,
+        /// 読む捕獲手の集合が変わるノード数。
+        nodes_set_differs: u64,
+    }
+}
+counters! {
+    /// 静かな成功手の順位変化。
+    QuietSuccess {
+        /// 成功手の順位変化。
+        #[serde(flatten)]
+        ranks: RankChange,
+        /// 大きさ2以上の同点群に属する成功手数。
+        from_tie_group_ge2: u64,
+    }
+}
+counters! {
+    /// 候補5の同点とPST差分の観測。
+    Candidate5 {
+        /// 静かな手が1手以上ある整列の回数。
+        quiet_stage_nodes: u64,
+        /// PST差分によって先頭が変わる数。
+        head_changed: u64,
+        /// 整列対象の手の総数。
+        quiets_total: u64,
+        /// history値が0の手の数。
+        quiets_history_zero: u64,
+        /// history同点群の大きさ別件数。
+        tie_groups: TieSize<u64>,
+        /// 大きさ2以上の同点群に属する手の数。
+        quiets_in_tie_groups_ge2: u64,
+        /// βカットまたはαを上げた手の順位変化。
+        success_moves: QuietSuccess,
+    }
+}
+
+use super::ordering::{MovePickerStage, move_order_key};
+use super::searcher::Searcher;
+use super::see::see_prunes;
+use core::cmp::Reverse;
+use minase_core::{Move, Position};
+
+/// 再帰呼び出しで上書きされない、通常探索1ノードの観測状態。
+pub(super) struct NodeObservation {
+    depth: usize,
+    cand2: bool,
+    tt_searched: bool,
+    first_type: Option<usize>,
+    work: u64,
+    head_negative: bool,
+    head_with_killer: bool,
+    shadow_order: Vec<Move>,
+    carry_order: Vec<Move>,
+}
+impl NodeObservation {
+    pub(super) fn new(searcher: &mut Searcher<'_>, depth: u32, zero_window: bool) -> Self {
+        let bucket = depth.min(4) as usize - 1;
+        let cand2 = depth <= 3 && zero_window;
+        searcher.ordering_diag.loop_nodes[bucket] += 1;
+        if cand2 {
+            searcher.ordering_diag.cand2[bucket][0].zero_window_nodes += 1;
+        }
+        Self {
+            depth: bucket,
+            cand2,
+            tt_searched: false,
+            first_type: None,
+            work: 0,
+            head_negative: false,
+            head_with_killer: false,
+            shadow_order: Vec::new(),
+            carry_order: Vec::new(),
+        }
+    }
+
+    /// next直後に観測し、捕獲段の先頭かどうかを返す。
+    pub(super) fn picked(
+        &mut self,
+        searcher: &mut Searcher<'_>,
+        position: &Position,
+        ply: usize,
+        mv: Move,
+        tt_move: Option<Move>,
+    ) -> bool {
+        if matches!(
+            searcher.move_pickers[ply].last_stage,
+            MovePickerStage::Quiets
+        ) && searcher.move_pickers[ply].quiet_index() == 1
+        {
+            searcher.observe_carry_quiets(position, ply);
+        }
+        let picker = &searcher.move_pickers[ply];
+        let stage = picker.last_stage;
+        if matches!(stage, MovePickerStage::Tt) {
+            self.tt_searched = true;
+            if self.cand2 {
+                searcher.ordering_diag.cand2[self.depth][0].zero_window_nodes -= 1;
+                searcher.ordering_diag.cand2[self.depth][1].zero_window_nodes += 1;
+            }
+        }
+        if matches!(stage, MovePickerStage::Quiets) && picker.quiet_index() == 1 {
+            searcher.ordering_diag.cand5 += picker.diag_quiet_observation;
+        }
+        let head = matches!(stage, MovePickerStage::Captures) && picker.capture_index() == 1;
+        if head {
+            if let Some(carry) = searcher.carry.as_deref_mut() {
+                let mut candidate: Vec<_> = picker
+                    .diag_capture_generation
+                    .iter()
+                    .map(|&mv| {
+                        let mut key = move_order_key(position, searcher.pst, mv).expect("capture");
+                        let value = carry.capture_history.read(position, searcher.pst, mv);
+                        carry.counts.ch_refs += 1;
+                        carry.counts.ch_nonzero += u64::from(value != 0);
+                        key.captured_value +=
+                            carry.capture_history.adjustment(position, searcher.pst, mv);
+                        (mv, key)
+                    })
+                    .collect();
+                candidate
+                    .sort_by_key(|&(_, key)| (Reverse(key.captured_value), key.attacker_value));
+                self.carry_order = candidate.into_iter().map(|(mv, _)| mv).collect();
+                if self.carry_order.len() >= 2 {
+                    carry.counts.ch_segments += 1;
+                    carry.counts.ch_segments_changed += u64::from(
+                        !picker
+                            .captures()
+                            .iter()
+                            .map(|&(mv, _)| mv)
+                            .eq(self.carry_order.iter().copied()),
+                    );
+                }
+            }
+            // 安定整列の同点は、本番整列前の生成順で解決する。
+            let mut shadow: Vec<_> = picker
+                .diag_capture_generation
+                .iter()
+                .map(|&mv| {
+                    let mut key = move_order_key(position, searcher.pst, mv).expect("capture");
+                    key.captured_value +=
+                        searcher
+                            .shadow_capture_history
+                            .adjustment(position, searcher.pst, mv);
+                    (mv, key)
+                })
+                .collect();
+            shadow.sort_by_key(|&(_, key)| (Reverse(key.captured_value), key.attacker_value));
+            self.shadow_order = shadow.into_iter().map(|(mv, _)| mv).collect();
+            if self.shadow_order.len() >= 2 {
+                searcher.ordering_diag.cand1.segments += 1;
+                searcher.ordering_diag.cand1.segments_changed += u64::from(
+                    !picker
+                        .captures()
+                        .iter()
+                        .map(|&(mv, _)| mv)
+                        .eq(self.shadow_order.iter().copied()),
+                );
+            }
+            let see_started = std::time::Instant::now();
+            self.head_negative = see_prunes(position, searcher.rules, searcher.pst, mv, 0);
+            searcher.ordering_diag.cost.see_ns += see_started.elapsed().as_nanos() as u64;
+            searcher.ordering_diag.cost.see_calls += 1;
+            if self.cand2 && self.head_negative {
+                let counts =
+                    &mut searcher.ordering_diag.cand2[self.depth][usize::from(self.tt_searched)];
+                counts.head_negative += 1;
+                counts.generate_quiets_calls += 1;
+                let generation_started = std::time::Instant::now();
+                searcher.generator.generate_quiets(
+                    position,
+                    &mut searcher.diag_base_moves,
+                    &mut searcher.diag_quiets,
+                );
+                searcher.ordering_diag.cost.generate_quiets_ns +=
+                    generation_started.elapsed().as_nanos() as u64;
+                searcher.ordering_diag.cost.generate_quiets_calls += 1;
+                self.head_with_killer = searcher.killers[ply].iter().flatten().any(|&killer| {
+                    Some(killer) != tt_move && searcher.diag_quiets.contains(&killer)
+                });
+                counts.head_negative_with_killer += u64::from(self.head_with_killer);
+            }
+        }
+        head
+    }
+
+    pub(super) fn pruned_head(&self, searcher: &mut Searcher<'_>, head: bool) {
+        if head && self.cand2 && self.head_negative {
+            searcher.ordering_diag.cand2[self.depth][usize::from(self.tt_searched)]
+                .head_negative_pruned += 1;
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn searched(
+        &mut self,
+        searcher: &mut Searcher<'_>,
+        ply: usize,
+        head: bool,
+        subtree: u64,
+        cutoff: bool,
+        raised_alpha: bool,
+        mv: Move,
+    ) {
+        let picker = &searcher.move_pickers[ply];
+        let stage = picker.last_stage;
+        let first = self.first_type.is_none();
+        let first_type = *self.first_type.get_or_insert(match stage {
+            MovePickerStage::Tt => 0,
+            MovePickerStage::Captures => {
+                if self.head_negative {
+                    1
+                } else {
+                    2
+                }
+            }
+            MovePickerStage::Killer0 | MovePickerStage::Killer1 => 3,
+            MovePickerStage::Quiets | MovePickerStage::Done => 4,
+        });
+        let diag = &mut searcher.ordering_diag;
+        if head {
+            let counts = &mut diag.capture_head[self.depth][usize::from(self.tt_searched)]
+                [usize::from(!self.head_negative)];
+            counts.count += 1;
+            counts.subtree_sum += subtree;
+            counts.cut_by_head += u64::from(cutoff);
+            if self.cand2 && self.head_negative {
+                let counts = &mut diag.cand2[self.depth][usize::from(self.tt_searched)];
+                counts.head_negative_subtree_sum += subtree;
+                if self.head_with_killer {
+                    counts.head_negative_with_killer_subtree_sum += subtree;
+                }
+            }
+        }
+        if matches!(stage, MovePickerStage::Quiets) && (cutoff || raised_alpha) {
+            let rank = picker.quiet_index() - 1;
+            diag.cand5
+                .success_moves
+                .ranks
+                .record(rank, picker.diag_candidate_rank[rank]);
+            diag.cand5.success_moves.from_tie_group_ge2 +=
+                u64::from(picker.diag_tie_sizes[rank] >= 2);
+        }
+        if cutoff {
+            let counts = &mut diag.w[self.depth][first_type];
+            counts.count += 1;
+            counts.w_sum += self.work;
+            counts.first_move_cutoffs += u64::from(first);
+            let cut_type = match stage {
+                MovePickerStage::Tt => 0,
+                MovePickerStage::Captures => 1,
+                MovePickerStage::Killer0 | MovePickerStage::Killer1 => 2,
+                MovePickerStage::Quiets | MovePickerStage::Done => 3,
+            };
+            diag.cut_move_type[self.depth][cut_type] += 1;
+            if !picker.quiets_generated() {
+                diag.cutoff_before_quiets[self.depth] += 1;
+                if self.cand2 && self.head_with_killer {
+                    diag.cand2[self.depth][usize::from(self.tt_searched)]
+                        .head_negative_with_killer_cutoff_before_quiets += 1;
+                }
+            }
+            if matches!(stage, MovePickerStage::Captures) {
+                if let Some(carry) = searcher.carry.as_deref_mut() {
+                    let candidate = self
+                        .carry_order
+                        .iter()
+                        .position(|&m| m == mv)
+                        .expect("carried order contains cutoff capture");
+                    let current = picker.capture_index() - 1;
+                    let counts = &mut carry.counts;
+                    counts.ch_cut_count += 1;
+                    if current > candidate {
+                        counts.ch_cut_forward += 1;
+                        counts.ch_cut_forward_sum += (current - candidate) as u64;
+                    } else if current < candidate {
+                        counts.ch_cut_backward += 1;
+                        counts.ch_cut_backward_sum += (candidate - current) as u64;
+                    }
+                }
+                let candidate = self
+                    .shadow_order
+                    .iter()
+                    .position(|&candidate| candidate == mv)
+                    .expect("shadow contains cutoff capture");
+                diag.cand1
+                    .capture_cut_rank
+                    .record(picker.capture_index() - 1, candidate);
+            }
+        }
+        self.work += subtree;
+    }
+
+    pub(super) fn finished(&self, searcher: &mut Searcher<'_>, cutoff: bool) {
+        if !cutoff {
+            searcher.ordering_diag.no_cutoff_nodes[self.depth] += 1;
+        }
+    }
+}

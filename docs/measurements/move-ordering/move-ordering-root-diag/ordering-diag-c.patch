@@ -0,0 +1,290 @@
+//! 候補7・8の受動診断。探索の判断には使わない。
+
+use super::{params, searcher::Searcher};
+use core::cmp::Reverse;
+use core::ops::AddAssign;
+use minase_core::{Move, Position};
+
+/// ワーカー別に計数し、探索終了時に合算する診断値。
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq, serde::Serialize)]
+pub struct OrderingDiag {
+    /// 深さ1を含む主ワーカーの完了反復数。
+    pub iterations: u64,
+    /// 完了反復のノード数の合計。窓の読み直しを含む。
+    pub iteration_nodes: u64,
+    /// 直前の完了反復から最善手が交替した反復数。
+    pub changed_iterations: u64,
+    /// 最善手が交替した完了反復のノード数の合計。
+    pub changed_iteration_nodes: u64,
+    /// 深さ2〜4の完了反復数。
+    pub iterations_d2_4: u64,
+    /// 深さ5〜6の完了反復数。
+    pub iterations_d5_6: u64,
+    /// 深さ7〜8の完了反復数。
+    pub iterations_d7_8: u64,
+    /// 深さ9以上の完了反復数。
+    pub iterations_d9_plus: u64,
+    /// 深さ2〜4の最善手が交替した反復数。
+    pub changed_d2_4: u64,
+    /// 深さ5〜6の最善手が交替した反復数。
+    pub changed_d5_6: u64,
+    /// 深さ7〜8の最善手が交替した反復数。
+    pub changed_d7_8: u64,
+    /// 深さ9以上の最善手が交替した反復数。
+    pub changed_d9_plus: u64,
+    /// 交替時の新最善手の現行順位の和。最終窓の0始まりの順位。
+    pub new_best_current_rank_sum: u64,
+    /// 交替時の新最善手の前回部分木ノード数による候補順位の和。
+    pub new_best_node_rank_sum: u64,
+    /// 交替時に候補順位が現行より小さい件数。
+    pub node_rank_better: u64,
+    /// 交替時に候補順位が現行より大きい件数。
+    pub node_rank_worse: u64,
+    /// 交替時に両順位が等しい件数。
+    pub node_rank_same: u64,
+    /// 主ワーカーの根で零窓から全窓へ読み直した回数。未完了反復も含む。
+    pub root_researches: u64,
+    /// 根の全窓読み直しのノード数の和。中断までの費用も含む。
+    pub root_research_nodes: u64,
+    /// 静かな手が1手以上あるQuiets段の整列回数。
+    pub cand8_quiet_stage_nodes: u64,
+    /// 影のhistory値でQuiets段の手順が変わるノード数。
+    pub cand8_order_changed: u64,
+    /// 通常探索でlmr_reductionを計算した手の数。
+    pub cand8_lmr_moves: u64,
+    /// 影のhistory値で減深量が変わる手の数。
+    pub cand8_lmr_changed: u64,
+    /// 減深計算時に影の値が負側のhistory閾値以下だった手の数。
+    pub cand8_lmr_negative: u64,
+    /// 整列比較と減深比較で影のhistory表を参照した回数。
+    pub cand8_refs: u64,
+    /// 影のhistory表の参照値が負だった回数。
+    pub cand8_negative_refs: u64,
+}
+
+impl AddAssign for OrderingDiag {
+    fn add_assign(&mut self, rhs: Self) {
+        self.iterations += rhs.iterations;
+        self.iteration_nodes += rhs.iteration_nodes;
+        self.changed_iterations += rhs.changed_iterations;
+        self.changed_iteration_nodes += rhs.changed_iteration_nodes;
+        self.iterations_d2_4 += rhs.iterations_d2_4;
+        self.iterations_d5_6 += rhs.iterations_d5_6;
+        self.iterations_d7_8 += rhs.iterations_d7_8;
+        self.iterations_d9_plus += rhs.iterations_d9_plus;
+        self.changed_d2_4 += rhs.changed_d2_4;
+        self.changed_d5_6 += rhs.changed_d5_6;
+        self.changed_d7_8 += rhs.changed_d7_8;
+        self.changed_d9_plus += rhs.changed_d9_plus;
+        self.new_best_current_rank_sum += rhs.new_best_current_rank_sum;
+        self.new_best_node_rank_sum += rhs.new_best_node_rank_sum;
+        self.node_rank_better += rhs.node_rank_better;
+        self.node_rank_worse += rhs.node_rank_worse;
+        self.node_rank_same += rhs.node_rank_same;
+        self.root_researches += rhs.root_researches;
+        self.root_research_nodes += rhs.root_research_nodes;
+        self.cand8_quiet_stage_nodes += rhs.cand8_quiet_stage_nodes;
+        self.cand8_order_changed += rhs.cand8_order_changed;
+        self.cand8_lmr_moves += rhs.cand8_lmr_moves;
+        self.cand8_lmr_changed += rhs.cand8_lmr_changed;
+        self.cand8_lmr_negative += rhs.cand8_lmr_negative;
+        self.cand8_refs += rhs.cand8_refs;
+        self.cand8_negative_refs += rhs.cand8_negative_refs;
+    }
+}
+
+impl OrderingDiag {
+    /// 各goだけの診断値をUSIの1行に出力する。
+    pub(crate) fn write_info(&self, output: &mut dyn std::io::Write) -> std::io::Result<()> {
+        write!(output, "info string diag scope=search")?;
+        write!(output, " iterations={}", self.iterations)?;
+        write!(output, " iteration_nodes={}", self.iteration_nodes)?;
+        write!(output, " changed_iterations={}", self.changed_iterations)?;
+        write!(
+            output,
+            " changed_iteration_nodes={}",
+            self.changed_iteration_nodes
+        )?;
+        write!(output, " iterations_d2_4={}", self.iterations_d2_4)?;
+        write!(output, " iterations_d5_6={}", self.iterations_d5_6)?;
+        write!(output, " iterations_d7_8={}", self.iterations_d7_8)?;
+        write!(output, " iterations_d9_plus={}", self.iterations_d9_plus)?;
+        write!(output, " changed_d2_4={}", self.changed_d2_4)?;
+        write!(output, " changed_d5_6={}", self.changed_d5_6)?;
+        write!(output, " changed_d7_8={}", self.changed_d7_8)?;
+        write!(output, " changed_d9_plus={}", self.changed_d9_plus)?;
+        write!(
+            output,
+            " new_best_current_rank_sum={}",
+            self.new_best_current_rank_sum
+        )?;
+        write!(
+            output,
+            " new_best_node_rank_sum={}",
+            self.new_best_node_rank_sum
+        )?;
+        write!(output, " node_rank_better={}", self.node_rank_better)?;
+        write!(output, " node_rank_worse={}", self.node_rank_worse)?;
+        write!(output, " node_rank_same={}", self.node_rank_same)?;
+        write!(output, " root_researches={}", self.root_researches)?;
+        write!(output, " root_research_nodes={}", self.root_research_nodes)?;
+        write!(
+            output,
+            " cand8_quiet_stage_nodes={}",
+            self.cand8_quiet_stage_nodes
+        )?;
+        write!(output, " cand8_order_changed={}", self.cand8_order_changed)?;
+        write!(output, " cand8_lmr_moves={}", self.cand8_lmr_moves)?;
+        write!(output, " cand8_lmr_changed={}", self.cand8_lmr_changed)?;
+        write!(output, " cand8_lmr_negative={}", self.cand8_lmr_negative)?;
+        write!(output, " cand8_refs={}", self.cand8_refs)?;
+        write!(output, " cand8_negative_refs={}", self.cand8_negative_refs)?;
+        writeln!(output)
+    }
+}
+
+/// 主ワーカーが保持する、前回反復と現在の反復の根の観測。
+#[derive(Default)]
+pub(super) struct RootObservation {
+    previous_best: Option<Move>,
+    previous_nodes: Vec<(Move, u64)>,
+    current_nodes: Vec<(Move, u64)>,
+    pub(super) current_order: Vec<Move>,
+}
+
+impl RootObservation {
+    pub(super) fn begin_iteration(&mut self, moves: &[Move]) {
+        self.current_nodes = moves.iter().map(|&mv| (mv, 0)).collect();
+        self.current_order.clear();
+    }
+
+    pub(super) fn record_move(&mut self, mv: Move, nodes: u64) {
+        let entry = self
+            .current_nodes
+            .iter_mut()
+            .find(|entry| entry.0 == mv)
+            .expect("observed root move belongs to this iteration");
+        entry.1 += nodes;
+    }
+
+    pub(super) fn complete(&mut self, diag: &mut OrderingDiag, depth: u32, best: Move, nodes: u64) {
+        diag.iterations += 1;
+        diag.iteration_nodes += nodes;
+        let changed = self.previous_best.is_some_and(|previous| previous != best);
+        let band = match depth {
+            1 => None,
+            2..=4 => Some((&mut diag.iterations_d2_4, &mut diag.changed_d2_4)),
+            5..=6 => Some((&mut diag.iterations_d5_6, &mut diag.changed_d5_6)),
+            7..=8 => Some((&mut diag.iterations_d7_8, &mut diag.changed_d7_8)),
+            _ => Some((&mut diag.iterations_d9_plus, &mut diag.changed_d9_plus)),
+        };
+        if let Some((iterations, changes)) = band {
+            *iterations += 1;
+            *changes += u64::from(changed);
+        }
+        if changed {
+            diag.changed_iterations += 1;
+            diag.changed_iteration_nodes += nodes;
+            let current = self
+                .current_order
+                .iter()
+                .position(|&mv| mv == best)
+                .expect("final window contains new best move");
+            let candidate = node_order(
+                &self.current_order,
+                self.previous_best.unwrap(),
+                &self.previous_nodes,
+            )
+            .iter()
+            .position(|&mv| mv == best)
+            .expect("candidate contains new best move");
+            diag.new_best_current_rank_sum += current as u64;
+            diag.new_best_node_rank_sum += candidate as u64;
+            diag.node_rank_better += u64::from(candidate < current);
+            diag.node_rank_worse += u64::from(candidate > current);
+            diag.node_rank_same += u64::from(candidate == current);
+        }
+        self.previous_best = Some(best);
+        self.previous_nodes.clone_from(&self.current_nodes);
+    }
+}
+
+/// 前回最善手を先頭に固定し、残りを部分木ノード数の降順、同点は現行順に並べる。
+pub(super) fn node_order(
+    current: &[Move],
+    previous_best: Move,
+    previous_nodes: &[(Move, u64)],
+) -> Vec<Move> {
+    let mut candidate = current.to_vec();
+    candidate.sort_by_cached_key(|&mv| {
+        let nodes = previous_nodes
+            .iter()
+            .find(|entry| entry.0 == mv)
+            .expect("previous completed iteration records every root move")
+            .1;
+        (mv != previous_best, Reverse(nodes))
+    });
+    candidate
+}
+
+/// 指示書のgravity更新式。加点・減点の両方をi64で計算する。
+pub(super) fn update_shadow_value(value: &mut i32, bonus: i64) {
+    let old = i64::from(*value);
+    *value = (old + bonus - old * bonus.abs() / i64::from(params::history_limit())) as i32;
+}
+
+impl Searcher<'_> {
+    pub(super) fn record_shadow_cutoff(
+        &mut self,
+        position: &Position,
+        mv: Move,
+        earlier: &[Move],
+        depth: u32,
+    ) {
+        let history = &mut self.shadow_history[position.side_to_move().index()];
+        let bonus = i64::from(depth) * i64::from(depth);
+        update_shadow_value(
+            &mut history[mv.from.dense_index()][mv.to.dense_index()],
+            bonus,
+        );
+        for mv in earlier {
+            update_shadow_value(
+                &mut history[mv.from.dense_index()][mv.to.dense_index()],
+                -bonus,
+            );
+        }
+    }
+
+    pub(super) fn shadow_history_value(&mut self, position: &Position, mv: Move) -> i32 {
+        let value = self.shadow_history[position.side_to_move().index()][mv.from.dense_index()]
+            [mv.to.dense_index()];
+        self.ordering_diag.cand8_refs += 1;
+        self.ordering_diag.cand8_negative_refs += u64::from(value < 0);
+        value
+    }
+
+    /// Quiets段の最初の手を受け取った直後、探索や枝刈りより前に比較する。
+    pub(super) fn observe_shadow_quiets(&mut self, position: &Position, ply: usize) {
+        let picker = &self.move_pickers[ply];
+        if !picker.diag_first_quiet() {
+            return;
+        }
+        let mut candidate = picker.diag_quiet_order().to_vec();
+        for (history, _, index) in &mut candidate {
+            let mv = picker.diag_quiets()[*index];
+            let value = self.shadow_history[position.side_to_move().index()][mv.from.dense_index()]
+                [mv.to.dense_index()];
+            self.ordering_diag.cand8_refs += 1;
+            self.ordering_diag.cand8_negative_refs += u64::from(value < 0);
+            *history = Reverse(value);
+        }
+        candidate.sort_unstable();
+        self.ordering_diag.cand8_quiet_stage_nodes += 1;
+        self.ordering_diag.cand8_order_changed += u64::from(
+            !candidate
+                .iter()
+                .map(|key| key.2)
+                .eq(picker.diag_quiet_order().iter().map(|key| key.2)),
+        );
+    }
+}

+#[test]
+fn node_ranking_pins_previous_best_and_preserves_current_order_on_ties() {
+    let moves = legal_moves(&Position::initial());
+    let [a, b, c, d] = [moves[0], moves[1], moves[2], moves[3]];
+    let current = [c, a, b, d];
+    let nodes = [(a, 0), (b, 40), (c, 40), (d, 90)];
+    assert_eq!(node_order(&current, a, &nodes), [a, d, c, b]);
+    assert_eq!(node_order(&[a, b, c, d], a, &nodes), [a, d, b, c]);
+}
+
+#[test]
+fn completed_iterations_accumulate_windows_and_use_the_final_window_order() {
+    let moves = legal_moves(&Position::initial());
+    let [a, b, c, d] = [moves[0], moves[1], moves[2], moves[3]];
+    let roots = [a, b, c, d];
+    let mut obs = RootObservation::default();
+    let mut diag = OrderingDiag::default();
+    obs.begin_iteration(&roots);
+    obs.current_order = roots.to_vec();
+    obs.record_move(a, 10);
+    obs.record_move(b, 30);
+    obs.record_move(c, 20);
+    obs.record_move(c, 20); // 同じ深さの読み直しを合算。
+    obs.complete(&mut diag, 1, a, 80);
+    assert_eq!(diag.iterations, 1);
+    assert_eq!(diag.iterations_d2_4, 0);
+    assert_eq!(diag.changed_iterations, 0);
+    obs.begin_iteration(&roots);
+    obs.current_order = vec![a, c, b, d];
+    obs.current_order = roots.to_vec(); // 最善手が確定した最後の窓。
+    obs.complete(&mut diag, 2, c, 100);
+    assert_eq!(diag.iteration_nodes, 180);
+    assert_eq!(diag.changed_iteration_nodes, 100);
+    assert_eq!(diag.iterations_d2_4, 1);
+    assert_eq!(diag.changed_d2_4, 1);
+    assert_eq!(diag.new_best_current_rank_sum, 2);
+    assert_eq!(diag.new_best_node_rank_sum, 1);
+    assert_eq!(diag.node_rank_better, 1);
+    for depth in [4, 5, 6, 7, 8, 9, 10] {
+        obs.begin_iteration(&roots);
+        obs.current_order = roots.to_vec();
+        obs.complete(&mut diag, depth, c, 10);
+    }
+    assert_eq!(
+        [
+            diag.iterations_d2_4,
+            diag.iterations_d5_6,
+            diag.iterations_d7_8,
+            diag.iterations_d9_plus
+        ],
+        [2; 4]
+    );
+    assert_eq!(diag.changed_iterations, 1);
+    // 中断反復はcompleteしないため、完了反復の計数に入らない。
+    let completed = diag;
+    obs.begin_iteration(&roots);
+    obs.record_move(b, 1000);
+    assert_eq!(diag, completed);
+}

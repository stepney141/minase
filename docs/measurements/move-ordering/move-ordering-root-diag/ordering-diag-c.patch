+//! diag-c.mdの計数契約、gravity更新式、根の候補順位を固定する。
+use super::*;
+use crate::search::OrderingDiag;
+use crate::search::alphabeta::ordering_diag::{RootObservation, node_order, update_shadow_value};
+use crate::search::alphabeta::params;
+
+fn all_counts(n: u64) -> OrderingDiag {
+    OrderingDiag {
+        iterations: n,
+        iteration_nodes: n,
+        changed_iterations: n,
+        changed_iteration_nodes: n,
+        iterations_d2_4: n,
+        iterations_d5_6: n,
+        iterations_d7_8: n,
+        iterations_d9_plus: n,
+        changed_d2_4: n,
+        changed_d5_6: n,
+        changed_d7_8: n,
+        changed_d9_plus: n,
+        new_best_current_rank_sum: n,
+        new_best_node_rank_sum: n,
+        node_rank_better: n,
+        node_rank_worse: n,
+        node_rank_same: n,
+        root_researches: n,
+        root_research_nodes: n,
+        cand8_quiet_stage_nodes: n,
+        cand8_order_changed: n,
+        cand8_lmr_moves: n,
+        cand8_lmr_changed: n,
+        cand8_lmr_negative: n,
+        cand8_refs: n,
+        cand8_negative_refs: n,
+    }
+}
+
+#[test]
+fn add_assign_sums_every_counter_and_outputs_every_key() {
+    let mut sum = all_counts(2);
+    sum += all_counts(7);
+    assert_eq!(sum, all_counts(9));
+    sum += OrderingDiag::default();
+    assert_eq!(sum, all_counts(9));
+    let json = serde_json::to_value(sum).unwrap();
+    assert_eq!(json.as_object().unwrap().len(), 26);
+    assert!(json.as_object().unwrap().values().all(|value| value == 9));
+    let mut line = Vec::new();
+    sum.write_info(&mut line).unwrap();
+    let line = String::from_utf8(line).unwrap();
+    assert!(line.starts_with("info string diag scope=search "));
+    assert_eq!(line.lines().count(), 1);
+    for (key, value) in json.as_object().unwrap() {
+        assert!(
+            line.split_whitespace()
+                .any(|item| item == format!("{key}={value}"))
+        );
+    }
+}
+
+#[test]
+fn shadow_gravity_rewards_penalizes_and_saturates_at_both_limits() {
+    let limit = params::history_limit();
+    let mut value = 0;
+    update_shadow_value(&mut value, 9);
+    assert_eq!(value, 9);
+    update_shadow_value(&mut value, -4);
+    assert_eq!(value, 5);
+    value = limit / 2;
+    update_shadow_value(&mut value, 100);
+    assert_eq!(value, limit / 2 + 50);
+    value = -limit / 2;
+    update_shadow_value(&mut value, -100);
+    assert_eq!(value, -limit / 2 - 50);
+    for sign in [-1, 1] {
+        value = 0;
+        update_shadow_value(&mut value, i64::from(sign * limit));
+        assert_eq!(value, sign * limit);
+        update_shadow_value(&mut value, i64::from(sign * 25));
+        assert_eq!(value, sign * limit);
+        update_shadow_value(&mut value, i64::from(-sign * 25));
+        assert_eq!(value, sign * (limit - 50));
+    }
+}

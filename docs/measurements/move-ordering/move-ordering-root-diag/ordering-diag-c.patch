+#[test]
+fn shadow_cutoff_updates_only_the_winner_and_searched_quiets() {
+    let board = Position::initial();
+    let moves = legal_moves(&board);
+    // 同じbutterfly entryの重複がない手を選ぶ。
+    let mut distinct = Vec::new();
+    for mv in moves {
+        if !distinct
+            .iter()
+            .any(|m: &Move| m.from == mv.from && m.to == mv.to)
+        {
+            distinct.push(mv);
+        }
+    }
+    with_root_searcher(&board, &[], |searcher| {
+        let before = *searcher.history;
+        searcher.record_shadow_cutoff(&board, distinct[2], &distinct[..2], 3);
+        for (index, &mv) in distinct[..4].iter().enumerate() {
+            assert_eq!(
+                searcher.shadow_history_value(&board, mv),
+                [-9, -9, 9, 0][index]
+            );
+        }
+        assert_eq!(*searcher.history, before);
+        assert_eq!(searcher.ordering_diag.cand8_refs, 4);
+        assert_eq!(searcher.ordering_diag.cand8_negative_refs, 2);
+    });
+    with_root_searcher(&board, &[], |searcher| {
+        assert!(
+            searcher
+                .shadow_history
+                .iter()
+                .flatten()
+                .flatten()
+                .all(|&v| v == 0)
+        );
+    });
+}

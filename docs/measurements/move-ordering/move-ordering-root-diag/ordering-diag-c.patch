+#[test]
+fn quiet_order_comparison_reuses_pst_ties_and_does_not_change_the_picker() {
+    let board = Position::initial();
+    with_root_searcher(&board, &[], |searcher| {
+        let mut reference = MovePicker::new(None, [None; KILLER_COUNT]);
+        let expected: Vec<_> = std::iter::from_fn(|| {
+            reference.next(
+                &board,
+                searcher.pst,
+                &searcher.generator,
+                searcher.history,
+                searcher.capture_history,
+            )
+        })
+        .collect();
+        assert!(expected.iter().all(|&(_, capture)| !capture));
+        let last = expected.last().unwrap().0;
+        // 末尾の手にのみ大きい値を与え、影の順序が変わることを独立に確定する。
+        searcher.shadow_history[board.side_to_move().index()][last.from.dense_index()]
+            [last.to.dense_index()] = 1000;
+        let mut actual = Vec::new();
+        while let Some(mv) = searcher.move_pickers[0].next(
+            &board,
+            searcher.pst,
+            &searcher.generator,
+            searcher.history,
+            searcher.capture_history,
+        ) {
+            searcher.observe_shadow_quiets(&board, 0);
+            actual.push(mv);
+        }
+        assert_eq!(actual, expected);
+        assert_eq!(searcher.ordering_diag.cand8_quiet_stage_nodes, 1);
+        assert_eq!(searcher.ordering_diag.cand8_order_changed, 1);
+        assert_eq!(searcher.ordering_diag.cand8_refs, expected.len() as u64);
+        // 影の値も全て同点なら、現行と同じPST差分と生成順で一致する。
+        searcher.shadow_history[board.side_to_move().index()][last.from.dense_index()]
+            [last.to.dense_index()] = 0;
+        searcher.move_pickers[0].reset(None, [None; KILLER_COUNT], false);
+        searcher.move_pickers[0]
+            .next(
+                &board,
+                searcher.pst,
+                &searcher.generator,
+                searcher.history,
+                searcher.capture_history,
+            )
+            .unwrap();
+        searcher.observe_shadow_quiets(&board, 0);
+        assert_eq!(searcher.ordering_diag.cand8_quiet_stage_nodes, 2);
+        assert_eq!(searcher.ordering_diag.cand8_order_changed, 1);
+    });
+}
+
+#[test]
+fn quiet_tt_and_killers_receive_shadow_rewards_and_prior_move_penalties() {
+    let board = Position::initial();
+    let moves = legal_moves(&board);
+    let [tt_move, killer, winner] = [moves[0], moves[1], moves[2]];
+    with_root_searcher(&board, &[], |searcher| {
+        searcher.killers[0] = [Some(killer), Some(winner)];
+        searcher
+            .tt
+            .store(search_key(&board), 0, 0, Bound::Upper, Some(tt_move), 0);
+        for (mv, score) in [(tt_move, 0), (killer, 0), (winner, 20)] {
+            let mut child = board.clone();
+            child.make_move_unchecked(mv, engine_rules());
+            searcher
+                .tt
+                .store(search_key(&child), 1, -score, Bound::Exact, None, 1);
+        }
+        assert_eq!(
+            searcher.negamax(&mut board.clone(), 2, -10, 10, 0),
+            Some(20)
+        );
+        for (mv, expected) in [(tt_move, -4), (killer, -4), (winner, 4)] {
+            assert_eq!(searcher.shadow_history_value(&board, mv), expected);
+        }
+        assert_eq!(searcher.ordering_diag.cand8_quiet_stage_nodes, 0);
+        assert_eq!(searcher.ordering_diag.cand8_lmr_moves, 0);
+    });
+}

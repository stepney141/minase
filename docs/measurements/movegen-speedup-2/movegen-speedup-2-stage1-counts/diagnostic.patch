+/// 段階1の処理件数診断。単一ワーカー専用であり、速度測定には使わない。
+pub mod diagnostics {
+    use std::sync::atomic::{AtomicBool, AtomicU8, AtomicU64, Ordering::Relaxed};
+
+    macro_rules! counters {
+        ($($name:ident),+ $(,)?) => {
+            pub(crate) struct Counters {
+                $(pub(crate) $name: AtomicU64,)+
+            }
+            pub(crate) static COUNTS: Counters = Counters {
+                $($name: AtomicU64::new(0),)+
+            };
+            fn take_scalar_counts() -> Vec<(String, u64)> {
+                vec![$((stringify!($name).to_owned(), COUNTS.$name.swap(0, Relaxed)),)+]
+            }
+        };
+    }
+
+    counters!(
+        q_nodes,
+        q_tt_hit,
+        q_tt_cutoff,
+        q_tt_cutoff_standpat_ok,
+        q_standpat_cutoff,
+        q_standpat_cutoff_tt_hit,
+        q_generate,
+        q_generate_tt_move,
+        q_candidates_empty,
+        q_candidates_present,
+        init_nodes,
+        init_targets_sum,
+        init_targets_all_enemy,
+        init_control_calls,
+        init_slide_calls,
+        init_dirs_total,
+        init_dirs_ray_miss,
+        init_dirs_blocked_miss,
+        init_reaching_pieces,
+        main_tt_probe,
+        main_tt_hit,
+        see_calls,
+        see_after_exclusions,
+        see_early_eligible,
+        see_early_reference_none,
+        see_early_reference_nonnegative,
+        see_early_reference_negative,
+    );
+
+    pub(crate) static IN_COLLECT: AtomicBool = AtomicBool::new(false);
+    pub(crate) static TARGET_BIN: AtomicU8 = AtomicU8::new(0);
+    pub(crate) static TARGET_BINS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+    pub(crate) static CONTROL_BINS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+    pub(crate) static SLIDE_BINS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+    pub(crate) static REACHING_BINS: [AtomicU64; 18] = [const { AtomicU64::new(0) }; 18];
+
+    pub(crate) fn add(counter: &AtomicU64, value: u64) {
+        counter.fetch_add(value, Relaxed);
+    }
+
+    pub(crate) fn read(counter: &AtomicU64) -> u64 {
+        counter.load(Relaxed)
+    }
+
+    pub(crate) fn check(context: &str, key: &str, actual: u64, expected: u64) {
+        if actual != expected {
+            eprintln!("diagnostic mismatch: {context} {key} actual={actual} expected={expected}");
+            std::process::abort();
+        }
+    }
+
+    /// 局面ごとの恒等式を検査し、固定順の全件数を返してゼロへ戻す。
+    pub fn take(position: &str) -> Vec<(String, u64)> {
+        check(
+            position,
+            "q_node_partition",
+            read(&COUNTS.q_tt_cutoff) + read(&COUNTS.q_standpat_cutoff) + read(&COUNTS.q_generate),
+            read(&COUNTS.q_nodes),
+        );
+        check(
+            position,
+            "q_candidate_partition",
+            read(&COUNTS.q_candidates_empty) + read(&COUNTS.q_candidates_present),
+            read(&COUNTS.q_generate),
+        );
+        check(
+            position,
+            "init_dirs_total",
+            read(&COUNTS.init_dirs_total),
+            read(&COUNTS.init_slide_calls),
+        );
+        check(
+            position,
+            "see_early_partition",
+            read(&COUNTS.see_early_reference_none)
+                + read(&COUNTS.see_early_reference_nonnegative)
+                + read(&COUNTS.see_early_reference_negative),
+            read(&COUNTS.see_early_eligible),
+        );
+        check(
+            position,
+            "see_early_reference_negative",
+            read(&COUNTS.see_early_reference_negative),
+            0,
+        );
+        for (key, bins, total) in [
+            ("init_targets_bins", &TARGET_BINS, &COUNTS.init_nodes),
+            ("control_bins", &CONTROL_BINS, &COUNTS.init_control_calls),
+            ("slide_bins", &SLIDE_BINS, &COUNTS.init_slide_calls),
+            (
+                "reaching_bins",
+                &REACHING_BINS,
+                &COUNTS.init_reaching_pieces,
+            ),
+        ] {
+            check(position, key, bins.iter().map(read).sum(), read(total));
+        }
+        let mut values = take_scalar_counts();
+        for bin in 0..18 {
+            let label = if bin == 17 {
+                "17plus".to_owned()
+            } else {
+                bin.to_string()
+            };
+            values.push((
+                format!("init_targets_bin_{label}"),
+                TARGET_BINS[bin].swap(0, Relaxed),
+            ));
+        }
+        for bin in 0..18 {
+            let label = if bin == 17 {
+                "17plus".to_owned()
+            } else {
+                bin.to_string()
+            };
+            for (suffix, bins) in [
+                ("control_calls", &CONTROL_BINS),
+                ("slide_calls", &SLIDE_BINS),
+                ("reaching_pieces", &REACHING_BINS),
+            ] {
+                values.push((format!("bin{label}_{suffix}"), bins[bin].swap(0, Relaxed)));
+            }
+        }
+        values
+    }
+}

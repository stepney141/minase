@@ -0,0 +1,163 @@
+//! 第3期の再診断で使う件数カウンタ。診断用のビルドだけに入れ、本番の経路には入れない。
+#![allow(missing_docs, non_camel_case_types)]
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+
+macro_rules! counters {
+    ($($name:ident),+ $(,)?) => {
+        #[derive(Clone, Copy)]
+        #[repr(usize)]
+        pub enum C { $($name),+ }
+        const NAMES: &[&str] = &[$(stringify!($name)),+];
+    };
+}
+
+counters!(
+    // 利きの逆引き。s_はSEEからの呼び出し、o_はそれ以外。2つの組は同じ並びにする。
+    s_att_calls,
+    s_att_nonempty,
+    s_att_neigh_own,
+    s_att_neigh_candidate,
+    s_att_fixed_hit,
+    s_att_calls_fixed_hit,
+    s_att_dir_no_blocker,
+    s_att_dir_enemy_blocker,
+    s_att_dir_own_nonslider,
+    s_att_dir_hit,
+    s_att_calls_slide_hit,
+    s_att_dir_prefilter_pass,
+    s_att_calls_prefilter_none,
+    s_att_calls_lines_none,
+    s_att_special_present,
+    s_att_special_hit,
+    o_att_calls,
+    o_att_nonempty,
+    o_att_neigh_own,
+    o_att_neigh_candidate,
+    o_att_fixed_hit,
+    o_att_calls_fixed_hit,
+    o_att_dir_no_blocker,
+    o_att_dir_enemy_blocker,
+    o_att_dir_own_nonslider,
+    o_att_dir_hit,
+    o_att_calls_slide_hit,
+    o_att_dir_prefilter_pass,
+    o_att_calls_prefilter_none,
+    o_att_calls_lines_none,
+    o_att_special_present,
+    o_att_special_hit,
+    // SEE。
+    see_calls,
+    see_from_q_threshold,
+    see_from_q_floor,
+    see_from_picker,
+    see_exit_mid,
+    see_exit_kirin,
+    see_exit_pre,
+    see_entered_loop,
+    see_lookups,
+    see_first_empty,
+    see_exit_depth1,
+    see_exit_lion,
+    see_full,
+    see_lookups_1,
+    see_lookups_2,
+    see_lookups_3,
+    see_lookups_4p,
+    see_pruned,
+    // 静止探索。
+    q_nodes,
+    q_tt_hit,
+    q_tt_cut,
+    q_standpat_cut,
+    q_init,
+    q_init_special_present,
+    q_special_generated,
+    q_special_excluded,
+    q_enemy_sum,
+    q_targets_sum,
+    q_scan_pieces,
+    q_scan_reach_pass,
+    q_scan_capturers,
+    q_scan_slide_tests,
+    q_scan_slide_ray_pass,
+    q_scan_slide_hit,
+    q_scan_slider_pieces,
+    q_scan_slider_reach_pass,
+    q_scan_slider_capturers,
+    q_see_both,
+    q_see_both_pass,
+    q_ordinary_possible,
+    q_ranks_present,
+    q_groups_generated,
+    q_group_ordinary_emitted,
+    q_group_special_added,
+    q_tt_move_given,
+    q_tt_move_valid,
+    q_ret_tt,
+    q_ret_ordinary,
+    q_ret_special,
+    q_royal_capture,
+    q_searched,
+    q_node_ret0,
+    q_node_ret1,
+    q_node_ret2,
+    q_node_ret3_4,
+    q_node_ret5p,
+    q_node_groups0,
+    q_node_groups1,
+    q_node_groups2,
+    q_node_groups3p,
+    q_node_cut_tt,
+    q_node_cut_first_nontt,
+    q_node_cut_later,
+    q_node_nocut,
+    // 主探索の手選択器。
+    pk_nodes,
+    pk_tt_ret,
+    pk_capgen_nodes,
+    pk_caps_generated,
+    pk_caps_returned,
+    pk_killer_ret,
+    pk_quietgen_nodes,
+    pk_quiets_generated,
+    // 王手判定。
+    gc_calls,
+);
+
+const SLOTS: usize = 160;
+static V: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+/// SEEの交換列から利きの逆引きを呼んでいる間だけ真にする。
+pub static IN_SEE: AtomicBool = AtomicBool::new(false);
+/// 静止探索の初期化で通常駒を走査している間だけ真にする。
+pub static IN_COLLECT: AtomicBool = AtomicBool::new(false);
+
+const ATT_BLOCK: usize = C::o_att_calls as usize - C::s_att_calls as usize;
+
+#[inline]
+pub fn add(c: C, n: u64) {
+    V[c as usize].fetch_add(n, Relaxed);
+}
+
+#[inline]
+pub fn inc(c: C) {
+    add(c, 1);
+}
+
+/// `s_att_*`の名前で呼び、SEEの外では対応する`o_att_*`へ加える。
+#[inline]
+pub fn att(c: C, n: u64) {
+    let offset = if IN_SEE.load(Relaxed) { 0 } else { ATT_BLOCK };
+    V[c as usize + offset].fetch_add(n, Relaxed);
+}
+
+pub fn in_collect() -> bool {
+    IN_COLLECT.load(Relaxed)
+}
+
+pub fn dump() {
+    assert!(NAMES.len() <= SLOTS);
+    for (index, name) in NAMES.iter().enumerate() {
+        eprintln!("diag {name} {}", V[index].load(Relaxed));
+    }
+}

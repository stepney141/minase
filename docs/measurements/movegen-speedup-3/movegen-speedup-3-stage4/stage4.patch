+/// 静止探索用の生成列は、公開捕獲の順序つき部分列と捕獲升まで一致する。
+#[test]
+fn qsearch_special_captures_match_filtered_public_order() {
+    for rules in capture_test_rules() {
+        let generator = MoveGenerator::new(rules);
+        for position in capture_test_positions() {
+            let mut public = Vec::new();
+            generator.generate_captures(&position, &mut public);
+            let expected: Vec<_> = public
+                .into_iter()
+                .filter_map(|mv| {
+                    let piece = position.piece_at(mv.from).unwrap();
+                    (matches!(
+                        piece.kind(),
+                        Some(PieceKind::Lion | PieceKind::HornedFalcon | PieceKind::SoaringEagle)
+                    ) && !MoveGenerator::is_excluded_lion_capture(&position, mv))
+                    .then(|| CaptureCandidate {
+                        mv,
+                        piece,
+                        captured: position.captured_squares(mv),
+                    })
+                })
+                .collect();
+            let mut actual = Vec::new();
+            generator.generate_qsearch_special_captures(&position, &mut |c| actual.push(c));
+            assert_eq!(actual, expected, "rules={rules:?}");
+        }
+    }
+}

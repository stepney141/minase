+/// 診断用の作業量カウンタ。速度測定には使わない。
+static STAGE_COUNTS: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+fn stage_count(index: usize, n: usize) {
+    STAGE_COUNTS[index].fetch_add(n as u64, AtomicOrdering::Relaxed);
+}
+/// 診断カウンタを読み出して0へ戻す。
+pub fn stage_counts_take() -> Vec<u64> {
+    STAGE_COUNTS.iter().map(|v| v.swap(0, AtomicOrdering::Relaxed)).collect()
+}

+/// プロセス起動後の枝刈り診断の累積計数を、残り深さごとに標準エラーへ出力する。
+pub fn print_lmp_diagnostics() {
+    for depth_index in 0..3 {
+        eprint!("depth={}", depth_index + 1);
+        for (name, counters) in [
+            ("futility_pruned", &FUTILITY_PRUNED),
+            ("lmp_pruned", &LMP_PRUNED),
+            ("lmp_pruned_killer", &LMP_PRUNED_KILLER),
+            ("lmp_nodes", &LMP_NODES),
+            ("searched_captures_before", &SEARCHED_CAPTURES_BEFORE),
+            ("searched_quiets_before", &SEARCHED_QUIETS_BEFORE),
+            ("nodes_zero_quiet_before", &NODES_ZERO_QUIET_BEFORE),
+            ("eligible_nodes", &ELIGIBLE_NODES),
+        ] {
+            eprint!(
+                " {name}={}",
+                counters[depth_index].load(AtomicOrdering::Relaxed)
+            );
+        }
+        eprintln!();
+    }
+}

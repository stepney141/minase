diff --git a/src/search/alphabeta/mod.rs b/src/search/alphabeta/mod.rs
index 31689b9..8dd86d1 100644
--- a/src/search/alphabeta/mod.rs
+++ b/src/search/alphabeta/mod.rs
@@ -29,3 +29,43 @@ const INFINITY: i32 = MATE + 1;
 pub(crate) fn history_decay_for_test() -> i32 {
     params::history_decay()
 }
+
+/// フェーズ1-Gの診断計数。benchの1プロセス全体を集計する。
+mod range_counters {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    macro_rules! counters {
+        ($($name:ident),* $(,)?) => {
+            $(pub(super) static $name: AtomicU64 = AtomicU64::new(0);)*
+
+            pub(super) fn print() {
+                $(eprintln!("range_counter {}={}", stringify!($name), $name.load(Ordering::Relaxed));)*
+            }
+        };
+    }
+
+    counters!(
+        RFP_ELIGIBLE,
+        RFP_ACTIVE,
+        RAZOR1_ELIGIBLE,
+        RAZOR1_ACTIVE,
+        RAZOR2_ELIGIBLE,
+        RAZOR2_ACTIVE,
+        LMP_ELIGIBLE,
+        LMP_ACTIVE,
+        QSEARCH_ELIGIBLE,
+        QSEARCH_ACTIVE,
+        NULL_EXTRA_POSITIVE,
+        IMPROVING_REDUCED,
+        CAPTURE_HISTORY_NONZERO,
+    );
+
+    pub(super) fn increment(counter: &AtomicU64) {
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// bench終了時に診断計数を標準エラーへ出力する。
+pub fn print_range_counters() {
+    range_counters::print();
+}

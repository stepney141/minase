diff --git a/src/search/alphabeta/diag.rs b/src/search/alphabeta/diag.rs
new file mode 100644
index 0000000..5c8d60c
--- /dev/null
+++ b/src/search/alphabeta/diag.rs
@@ -0,0 +1,317 @@
+//! 段階12の受動的診断。影の値を探索の判断へ返さない。
+
+use super::ordering::{MoveOrderKey, piece_at_for_ordering};
+use super::royal::captures_last_royal;
+use super::see::{see_prunes, see_reference};
+use crate::core::piece::PieceKind;
+use crate::core::rules::MoveRules;
+use crate::eval::Pst;
+use crate::search::MAX_PLY;
+use crate::{Move, MoveGenerator, Position, Square};
+use core::cmp::Reverse;
+
+const D: i32 = 20_755;
+const Q_LIMITS: [usize; 5] = [1, 2, 3, 4, 6];
+
+macro_rules! counters {
+    ($($name:ident),* $(,)?) => {
+        /// 段階12診断の計数。探索ワーカー終了後にのみ合算する。
+        #[derive(Clone, Debug, Default, PartialEq, Eq, serde::Serialize)]
+        pub struct Counters {
+            $(pub(super) $name: u64,)*
+        }
+        impl Counters {
+            /// 別のワーカーまたは局面の計数を加える。
+            pub fn add(&mut self, other: &Self) {
+                $(self.$name += other.$name;)*
+            }
+            /// USIのinfo string diagへ渡す整数の列。
+            pub fn info(&self) -> String {
+                [$(format!("{}={}", stringify!($name), self.$name),)*].join(" ")
+            }
+        }
+    };
+}
+
+counters! {
+    asp_iterations,
+    asp_failhigh_iterations,
+    asp_failhigh_hist_1,
+    asp_failhigh_hist_2,
+    asp_failhigh_hist_3,
+    asp_failhigh_hist_4plus,
+    asp_iterations_aborted,
+    capture_stage_nodes,
+    bad_capture_order_changed,
+    bad_capture_reached,
+    bad_capture_excluded_royal,
+    bad_capture_excluded_double,
+    bad_capture_see_unknown,
+    capture_history_nodes,
+    capture_history_order_changed,
+    capture_history_reached,
+    capture_history_refs,
+    capture_history_nonzero_refs,
+    q_nodes,
+    q_searched,
+    q_good,
+    q_exempt_royal,
+    q_exempt_recapture,
+    q_exempt_double,
+    null_tried,
+    null_skip_pv,
+    null_skip_eval,
+    null_skip_any,
+    pv_nodes_negamax,
+    pv_tt_cut_negamax,
+    pv_nodes_quiesce,
+    pv_tt_cut_quiesce,
+    q_lost_1,
+    q_lost_2,
+    q_lost_3,
+    q_lost_4,
+    q_lost_6,
+    q_prune_nodes_1,
+    q_prune_nodes_2,
+    q_prune_nodes_3,
+    q_prune_nodes_4,
+    q_prune_nodes_6,
+    q_pruned_moves_1,
+    q_pruned_moves_2,
+    q_pruned_moves_3,
+    q_pruned_moves_4,
+    q_pruned_moves_6,
+}
+
+/// 1回のgoの中だけ存続するワーカー固有の状態。
+pub(super) struct Diagnostics {
+    pub(super) counts: Counters,
+    pub(super) main_worker: bool,
+    rules: MoveRules,
+    history: Vec<i16>,
+    // Someは直前の手が捕獲手だったことと、その到達升を同時に表す。
+    pub(super) previous: [Option<Square>; MAX_PLY as usize + 1],
+}
+
+impl Diagnostics {
+    pub(super) fn new(rules: MoveRules) -> Self {
+        Self {
+            counts: Counters::default(),
+            main_worker: true,
+            rules,
+            history: vec![0; 58 * 144 * 29],
+            previous: [None; MAX_PLY as usize + 1],
+        }
+    }
+
+    pub(super) fn aspiration(&mut self, maximum: usize, aborted: bool) {
+        self.counts.asp_iterations += 1;
+        self.counts.asp_iterations_aborted += u64::from(aborted);
+        self.counts.asp_failhigh_iterations += u64::from(maximum > 0);
+        match maximum {
+            0 => {}
+            1 => self.counts.asp_failhigh_hist_1 += 1,
+            2 => self.counts.asp_failhigh_hist_2 += 1,
+            3 => self.counts.asp_failhigh_hist_3 += 1,
+            _ => self.counts.asp_failhigh_hist_4plus += 1,
+        }
+    }
+
+    fn history_index(position: &Position, pst: &Pst, mv: Move) -> usize {
+        let mover = piece_at_for_ordering(position, mv.from);
+        let victim = position
+            .captured_squares(mv)
+            .into_iter()
+            .flatten()
+            .map(|sq| piece_at_for_ordering(position, sq))
+            .max_by_key(|&piece| pst.piece_value(piece))
+            .expect("history indexes captures only");
+        let code = mover.color().expect("mover color").index() * 29
+            + mover.kind().expect("mover kind").index();
+        (code * 144 + mv.to.dense_index()) * 29 + victim.kind().expect("victim kind").index()
+    }
+
+    pub(super) fn capture_cutoff(
+        &mut self,
+        position: &Position,
+        pst: &Pst,
+        mv: Move,
+        earlier: &[Move],
+        depth: u32,
+    ) {
+        let bonus = (depth * depth).min(D as u32) as i32;
+        for (mv, bonus) in
+            core::iter::once((mv, bonus)).chain(earlier.iter().map(|&mv| (mv, -bonus)))
+        {
+            let value = &mut self.history[Self::history_index(position, pst, mv)];
+            let old = i32::from(*value);
+            *value = (old + bonus - old * bonus.abs() / D) as i16;
+        }
+    }
+
+    /// 生成順の配列を読み、順序が変わる最初の位置だけを保持する。
+    pub(super) fn captures(
+        &mut self,
+        position: &Position,
+        pst: &Pst,
+        generator: &MoveGenerator,
+        tt_move: Option<Move>,
+        captures: &[(Move, MoveOrderKey)],
+    ) -> CaptureObservation {
+        self.counts.capture_stage_nodes += 1;
+        let mut negative = Vec::with_capacity(captures.len());
+        let mut candidate = Vec::with_capacity(captures.len());
+        for &(mv, key) in captures {
+            let royal = captures_last_royal(position, mv);
+            let double = double_lion_capture(position, mv);
+            // 除外件数はSEEの符号と独立に数える。2枚取りはSEE判定不能でもある。
+            self.counts.bad_capture_excluded_royal += u64::from(royal);
+            self.counts.bad_capture_excluded_double += u64::from(double);
+            self.counts.bad_capture_see_unknown +=
+                u64::from(see_reference(position, self.rules, pst, mv).is_none());
+            let see_negative = see_prunes(position, self.rules, pst, mv, 0);
+            negative.push((mv, (!royal && !double && see_negative, see_negative)));
+            let value = i32::from(self.history[Self::history_index(position, pst, mv)]);
+            self.counts.capture_history_refs += 1;
+            self.counts.capture_history_nonzero_refs += u64::from(value != 0);
+            candidate.push((
+                mv,
+                (
+                    Reverse(key.captured_value + value * pst.pawn_value() / D),
+                    key.attacker_value,
+                ),
+            ));
+        }
+        // どちらも生成順から安定整列する。探索が使う配列には触れない。
+        candidate.sort_by_key(|&(_, key)| key);
+        let mut actual = captures.to_vec();
+        actual.sort_by_key(|&(_, key)| (Reverse(key.captured_value), key.attacker_value));
+        let negative: Vec<_> = actual
+            .iter()
+            .map(|(mv, _)| {
+                negative
+                    .iter()
+                    .find(|(observed, _)| observed == mv)
+                    .expect("observed capture")
+                    .1
+            })
+            .collect();
+        let first_difference = actual
+            .iter()
+            .zip(&candidate)
+            .position(|(actual, shadow)| actual.0 != shadow.0);
+        if captures.len() >= 2 {
+            self.counts.capture_history_nodes += 1;
+            self.counts.capture_history_order_changed += u64::from(first_difference.is_some());
+        }
+        let mut has_quiet = false;
+        if negative.iter().any(|&(eligible, _)| eligible) {
+            let mut scratch = Vec::new();
+            let mut quiets = Vec::new();
+            generator.generate_quiets(position, &mut scratch, &mut quiets);
+            has_quiet = quiets.iter().any(|&mv| Some(mv) != tt_move);
+        }
+        let first_bad = negative.iter().enumerate().position(|(i, &(eligible, _))| {
+            eligible
+                && (has_quiet
+                    || negative[i + 1..]
+                        .iter()
+                        .any(|&(_, see_negative)| !see_negative))
+        });
+        self.counts.bad_capture_order_changed += u64::from(first_bad.is_some());
+        CaptureObservation {
+            first_bad,
+            first_difference,
+        }
+    }
+
+    pub(super) fn record_move(&mut self, position: &Position, mv: Move, ply: u32) {
+        self.previous[(ply + 1) as usize] = position
+            .captured_squares(mv)
+            .iter()
+            .any(Option::is_some)
+            .then_some(mv.to);
+    }
+
+    pub(super) fn q_start(
+        &mut self,
+        node: &mut QNode,
+        position: &Position,
+        mv: Move,
+        ply: u32,
+        royal: bool,
+    ) -> bool {
+        node.k += 1;
+        self.counts.q_nodes += u64::from(node.k == 1);
+        self.counts.q_searched += 1;
+        let captured = position.captured_squares(mv);
+        let recapture = self.previous[ply as usize].is_some_and(|sq| captured.contains(&Some(sq)));
+        let double = double_lion_capture(position, mv);
+        if node.k > 2 {
+            self.counts.q_exempt_royal += u64::from(royal);
+            self.counts.q_exempt_recapture += u64::from(recapture);
+            self.counts.q_exempt_double += u64::from(double);
+        }
+        let exempt = royal || recapture || double;
+        if !exempt {
+            let counts = &mut self.counts;
+            let slots = [
+                (&mut counts.q_prune_nodes_1, &mut counts.q_pruned_moves_1),
+                (&mut counts.q_prune_nodes_2, &mut counts.q_pruned_moves_2),
+                (&mut counts.q_prune_nodes_3, &mut counts.q_pruned_moves_3),
+                (&mut counts.q_prune_nodes_4, &mut counts.q_pruned_moves_4),
+                (&mut counts.q_prune_nodes_6, &mut counts.q_pruned_moves_6),
+            ];
+            for (i, (nodes, moves)) in slots.into_iter().enumerate() {
+                if node.k > Q_LIMITS[i] {
+                    *moves += 1;
+                    *nodes += u64::from(!node.pruned[i]);
+                    node.pruned[i] = true;
+                }
+            }
+        }
+        exempt
+    }
+
+    pub(super) fn q_result(&mut self, node: &QNode, exempt: bool, good: bool) {
+        if !good {
+            return;
+        }
+        self.counts.q_good += 1;
+        if !exempt {
+            let counts = &mut self.counts;
+            for (limit, lost) in Q_LIMITS.into_iter().zip([
+                &mut counts.q_lost_1,
+                &mut counts.q_lost_2,
+                &mut counts.q_lost_3,
+                &mut counts.q_lost_4,
+                &mut counts.q_lost_6,
+            ]) {
+                *lost += u64::from(node.k > limit);
+            }
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct QNode {
+    k: usize,
+    pruned: [bool; 5],
+}
+
+pub(super) struct CaptureObservation {
+    first_bad: Option<usize>,
+    first_difference: Option<usize>,
+}
+
+impl CaptureObservation {
+    pub(super) fn returned(&self, index: usize, counts: &mut Counters) {
+        counts.bad_capture_reached += u64::from(self.first_bad == Some(index));
+        counts.capture_history_reached += u64::from(self.first_difference == Some(index));
+    }
+}
+
+fn double_lion_capture(position: &Position, mv: Move) -> bool {
+    piece_at_for_ordering(position, mv.from).kind() == Some(PieceKind::Lion)
+        && position.captured_squares(mv).iter().all(Option::is_some)
+}

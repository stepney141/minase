diff --git a/src/search/alphabeta/diag.rs b/src/search/alphabeta/diag.rs
new file mode 100644
index 0000000..d94dc97
--- /dev/null
+++ b/src/search/alphabeta/diag.rs
@@ -0,0 +1,182 @@
+//! 段階12項目5の受動的な再生診断。探索中は主ワーカーだけが表と計数器を所有する。
+
+use std::cmp::Reverse;
+use std::io::{self, Write};
+use std::sync::Mutex;
+
+use crate::Move;
+use crate::core::board::BOARD_SQUARE_COUNT;
+use crate::core::piece::{COLOR_COUNT, Color};
+
+use super::correction::CorrectionTable;
+use super::params;
+use super::pruning::lmr_reduction;
+use super::searcher::HistoryTable;
+
+static STORED: Mutex<Option<HistoryCarry>> = Mutex::new(None);
+
+pub(crate) fn enabled() -> bool {
+    std::env::var_os("MINASE_STAGE12_DIAG").is_some()
+}
+
+pub(crate) fn reset() {
+    if enabled() {
+        *STORED.lock().expect("diagnostic storage poisoned") = None;
+    }
+}
+
+pub(super) fn begin(pawn: i32) -> Option<HistoryCarry> {
+    if !enabled() {
+        return None;
+    }
+    let mut carry = match STORED.lock().expect("diagnostic storage poisoned").take() {
+        Some(carry) => carry,
+        None => HistoryCarry {
+            history: Box::new([[[0; BOARD_SQUARE_COUNT]; BOARD_SQUARE_COUNT]; COLOR_COUNT]),
+            correction: CorrectionTable::new(pawn),
+            counts: Counts::default(),
+        },
+    };
+    for value in carry.history.iter_mut().flatten().flatten() {
+        *value = *value * 3 / 4;
+    }
+    carry.counts.searches += 1;
+    Some(carry)
+}
+
+pub(super) fn finish(carry: Option<HistoryCarry>) {
+    if let Some(carry) = carry {
+        *STORED.lock().expect("diagnostic storage poisoned") = Some(carry);
+    }
+}
+
+pub(crate) fn write_info(output: &mut dyn Write) -> io::Result<()> {
+    if enabled() {
+        let stored = STORED.lock().expect("diagnostic storage poisoned");
+        // 合法手のない局面など、ワーカーを起動しないgoも累計を出力する。
+        let counts = stored
+            .as_ref()
+            .map_or(Counts::default(), |carry| carry.counts);
+        writeln!(
+            output,
+            "info string diag scope=game searches={} bf_order_nodes={} bf_order_changed={} bf_order_reached={} lmr_moves={} lmr_changed={} corr_moves={} corr_changed={} bf_refs={} bf_nonzero={} corr_refs={} corr_nonzero={}",
+            counts.searches,
+            counts.bf_order_nodes,
+            counts.bf_order_changed,
+            counts.bf_order_reached,
+            counts.lmr_moves,
+            counts.lmr_changed,
+            counts.corr_moves,
+            counts.corr_changed,
+            counts.bf_refs,
+            counts.bf_nonzero,
+            counts.corr_refs,
+            counts.corr_nonzero
+        )?;
+    }
+    Ok(())
+}
+
+#[derive(Default, Clone, Copy)]
+struct Counts {
+    searches: u64,
+    bf_order_nodes: u64,
+    bf_order_changed: u64,
+    bf_order_reached: u64,
+    lmr_moves: u64,
+    lmr_changed: u64,
+    corr_moves: u64,
+    corr_changed: u64,
+    bf_refs: u64,
+    bf_nonzero: u64,
+    corr_refs: u64,
+    corr_nonzero: u64,
+}
+
+#[derive(Default)]
+pub(super) struct PickerObservation {
+    sorted: bool,
+    first_difference: Option<usize>,
+}
+
+pub(super) struct HistoryCarry {
+    history: Box<HistoryTable>,
+    pub(super) correction: CorrectionTable,
+    counts: Counts,
+}
+
+impl HistoryCarry {
+    fn history_value(&mut self, side: Color, mv: Move) -> i32 {
+        let value = self.history[side.index()][mv.from.dense_index()][mv.to.dense_index()];
+        self.counts.bf_refs += 1;
+        self.counts.bf_nonzero += u64::from(value != 0);
+        value
+    }
+
+    pub(super) fn quiet_cutoff(&mut self, side: Color, mv: Move, depth: u32) {
+        let value = &mut self.history[side.index()][mv.from.dense_index()][mv.to.dense_index()];
+        *value += (depth * depth) as i32;
+        if *value > params::history_limit() {
+            for value in self.history.iter_mut().flatten().flatten() {
+                *value /= 2;
+            }
+        }
+    }
+
+    pub(super) fn observe_order(
+        &mut self,
+        observation: &mut PickerObservation,
+        side: Color,
+        quiets: &[Move],
+        order: &[(Reverse<i32>, usize)],
+        returned: usize,
+    ) {
+        if !observation.sorted {
+            observation.sorted = true;
+            self.counts.bf_order_nodes += 1;
+            let mut candidate: Vec<_> = order
+                .iter()
+                .map(|&(_, index)| (Reverse(self.history_value(side, quiets[index])), index))
+                .collect();
+            // 生成順の添字で同点を解決する点も現行の整列と同じ。
+            candidate.sort_unstable();
+            observation.first_difference = order
+                .iter()
+                .zip(&candidate)
+                .position(|(current, carried)| current.1 != carried.1);
+            self.counts.bf_order_changed += u64::from(observation.first_difference.is_some());
+        }
+        if observation
+            .first_difference
+            .is_some_and(|index| returned > index)
+        {
+            self.counts.bf_order_reached += 1;
+            observation.first_difference = None;
+        }
+    }
+
+    pub(super) fn observe_lmr(
+        &mut self,
+        side: Color,
+        mv: Move,
+        depth: u32,
+        index: usize,
+        current: u32,
+    ) {
+        let history = self.history_value(side, mv);
+        self.counts.lmr_moves += 1;
+        self.counts.lmr_changed += u64::from(lmr_reduction(depth, index, history) != current);
+    }
+
+    pub(super) fn correction_value(&mut self, side: Color, key: u64) -> i32 {
+        let value = self.correction.read(side, key);
+        self.counts.corr_refs += 1;
+        self.counts.corr_nonzero += u64::from(value != 0);
+        value
+    }
+
+    pub(super) fn observe_futility(&mut self, current: i32, carried: i32, alpha: i32) {
+        self.counts.corr_moves += 1;
+        self.counts.corr_changed += u64::from((current <= alpha) != (carried <= alpha));
+    }
+}

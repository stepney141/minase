+/// 段階8フェーズ1専用の一時診断。benchだけが初期化する。
+pub mod diagnostics {
+    use super::*;
+    use serde::Serialize;
+    use std::collections::{BTreeMap, HashMap};
+    use std::fs::{File, create_dir_all};
+    use std::io::{BufWriter, Write};
+    use std::path::PathBuf;
+    use std::sync::Mutex;
+
+    static OUTPUT: OnceLock<Mutex<Output>> = OnceLock::new();
+    struct Output {
+        directory: Option<PathBuf>,
+        lmr_path: Option<PathBuf>,
+        verify: bool,
+        sample_count: u64,
+        files: BTreeMap<String, BufWriter<File>>,
+        lines: BTreeMap<String, u64>,
+        counts: BTreeMap<String, BTreeMap<u32, u64>>,
+        totals: Vec<Stats>,
+        pawn: Option<i32>,
+    }
+    #[derive(Clone, Default, Serialize)]
+    struct Stats {
+        observations: u64,
+        absolute_error: u64,
+        corrected_error: u64,
+        reuse: u64,
+        keys: u64,
+        eligible_nodes: u64,
+        nonzero: u64,
+        exact: u64,
+        upper: u64,
+        lower: u64,
+    }
+    impl Stats {
+        fn add(&mut self, other: &Self) {
+            self.observations += other.observations;
+            self.absolute_error += other.absolute_error;
+            self.corrected_error += other.corrected_error;
+            self.reuse += other.reuse;
+            self.keys += other.keys;
+            self.eligible_nodes += other.eligible_nodes;
+            self.nonzero += other.nonzero;
+            self.exact += other.exact;
+            self.upper += other.upper;
+            self.lower += other.lower;
+        }
+    }
+    /// 診断出力を新規作成する。実行AとBの併用・並列benchは禁止。
+    pub fn initialize(threads: usize, repetitions: usize) {
+        let directory = std::env::var_os("MINASE_STAGE8_DIAG").map(PathBuf::from);
+        let lmr_path = std::env::var_os("MINASE_STAGE8_LMR_DIAG").map(PathBuf::from);
+        let verify = match std::env::var("MINASE_STAGE8_VERIFY") {
+            Ok(value) => {
+                assert_eq!(value, "1");
+                true
+            }
+            Err(std::env::VarError::NotPresent) => false,
+            Err(error) => panic!("{error}"),
+        };
+        assert!(!verify || directory.is_some());
+        if directory.is_none() && lmr_path.is_none() {
+            return;
+        }
+        assert_eq!(threads, 1);
+        assert_eq!(repetitions, 1);
+        assert!(directory.is_none() || lmr_path.is_none());
+        let mut files = BTreeMap::new();
+        if let Some(dir) = &directory {
+            create_dir_all(dir).unwrap();
+            for name in ["captures", "quiets", "nodes", "verify"] {
+                files.insert(
+                    name.to_owned(),
+                    BufWriter::new(File::create(dir.join(format!("{name}.txt"))).unwrap()),
+                );
+            }
+        }
+        if let Some(path) = &lmr_path {
+            files.insert(
+                "lmr".to_owned(),
+                BufWriter::new(File::create(path).unwrap()),
+            );
+        }
+        assert!(
+            OUTPUT
+                .set(Mutex::new(Output {
+                    directory,
+                    lmr_path,
+                    verify,
+                    sample_count: 0,
+                    files,
+                    lines: BTreeMap::new(),
+                    counts: BTreeMap::new(),
+                    totals: vec![Stats::default(); 9],
+                    pawn: None
+                }))
+                .is_ok()
+        );
+    }
+    pub(super) fn passive_enabled() -> bool {
+        OUTPUT
+            .get()
+            .is_some_and(|o| o.lock().unwrap().directory.is_some())
+    }
+    pub(super) fn lmr_enabled() -> bool {
+        OUTPUT
+            .get()
+            .is_some_and(|o| o.lock().unwrap().lmr_path.is_some())
+    }
+    pub(super) fn verify_next() -> bool {
+        let mut out = OUTPUT.get().unwrap().lock().unwrap();
+        out.sample_count += 1;
+        out.verify && out.sample_count.is_multiple_of(64)
+    }
+    pub(super) fn count(name: &str, depth: u32) {
+        let mut out = OUTPUT.get().unwrap().lock().unwrap();
+        *out.counts
+            .entry(name.into())
+            .or_default()
+            .entry(depth)
+            .or_default() += 1;
+    }
+    pub(super) fn line(name: &str, text: String) -> u64 {
+        let mut out = OUTPUT.get().unwrap().lock().unwrap();
+        writeln!(out.files.get_mut(name).unwrap(), "{text}").unwrap();
+        let n = out.lines.entry(name.into()).or_default();
+        *n += 1;
+        *n
+    }
+    /// 全探索の集計をJSONへ書き、標本ファイルをflushする。
+    pub fn finish() {
+        let Some(output) = OUTPUT.get() else {
+            return;
+        };
+        let mut out = output.lock().unwrap();
+        for file in out.files.values_mut() {
+            file.flush().unwrap();
+        }
+        if let Some(dir) = &out.directory {
+            let tables: Vec<_> = out.totals.iter().enumerate().map(|(i, stats)| {
+                serde_json::json!({"key": (["royals", "material", "combined"][i / 3]), "denominator": ([32, 64, 128][i % 3]), "stats": stats})
+            }).collect();
+            serde_json::to_writer_pretty(
+                File::create(dir.join("correction.json")).unwrap(),
+                &serde_json::json!({"pawn_value": out.pawn.unwrap(), "tables": tables}),
+            )
+            .unwrap();
+            serde_json::to_writer_pretty(
+                File::create(dir.join("counts.json")).unwrap(),
+                &serde_json::json!({"counts": out.counts, "lines": out.lines}),
+            )
+            .unwrap();
+        }
+        if let Some(path) = &out.lmr_path {
+            serde_json::to_writer_pretty(
+                File::create(path.with_extension("counts.json")).unwrap(),
+                &out.counts,
+            )
+            .unwrap();
+        }
+    }
+    pub(super) struct Worker {
+        tables: [HashMap<Vec<u8>, i64>; 9],
+        stats: [Stats; 9],
+        pawn: i32,
+        pub reference_tt: Option<TranspositionTable>,
+    }
+    impl Worker {
+        pub fn new(pawn: i32) -> Option<Self> {
+            let out = OUTPUT.get()?;
+            let mut out = out.lock().unwrap();
+            if let Some(previous) = out.pawn {
+                assert_eq!(previous, pawn);
+            }
+            out.pawn = Some(pawn);
+            Some(Self {
+                tables: std::array::from_fn(|_| HashMap::new()),
+                stats: std::array::from_fn(|_| Stats::default()),
+                pawn,
+                reference_tt: Some(TranspositionTable::new(1).unwrap()),
+            })
+        }
+        pub fn reference(&mut self, position: &Position) {
+            if !passive_enabled() {
+                return;
+            }
+            let keys = keys(position);
+            for i in 0..9 {
+                self.stats[i].eligible_nodes += 1;
+                let prediction = self.tables[i].get(&keys[i / 3]).copied().unwrap_or(0) / 1024;
+                self.stats[i].nonzero += u64::from(prediction != 0);
+            }
+        }
+        pub fn observe(
+            &mut self,
+            position: &Position,
+            depth: u32,
+            score: i32,
+            eval: i32,
+            bound: Bound,
+        ) {
+            if !passive_enabled()
+                || score.abs() >= MATE_THRESHOLD
+                || !(bound == Bound::Exact
+                    || (bound == Bound::Upper && score < eval)
+                    || (bound == Bound::Lower && score > eval))
+            {
+                return;
+            }
+            let keys = keys(position);
+            let difference = i64::from(score - eval);
+            let cap = i64::from(2 * self.pawn);
+            for i in 0..9 {
+                let old = self.tables[i].get(&keys[i / 3]).copied();
+                let fixed = old.unwrap_or(0);
+                let prediction = (fixed / 1024).clamp(-cap, cap);
+                let stats = &mut self.stats[i];
+                stats.observations += 1;
+                stats.absolute_error += difference.unsigned_abs();
+                stats.corrected_error += (difference - prediction).unsigned_abs();
+                stats.reuse += u64::from(old.is_some());
+                match bound {
+                    Bound::Exact => stats.exact += 1,
+                    Bound::Upper => stats.upper += 1,
+                    Bound::Lower => stats.lower += 1,
+                }
+                let updated = fixed
+                    + (difference * 1024 - fixed) * i64::from(depth.min(8)) / [32, 64, 128][i % 3];
+                self.tables[i].insert(keys[i / 3].clone(), updated.clamp(-cap * 1024, cap * 1024));
+            }
+        }
+    }
+    impl Drop for Worker {
+        fn drop(&mut self) {
+            let mut out = OUTPUT.get().unwrap().lock().unwrap();
+            for i in 0..9 {
+                self.stats[i].keys = self.tables[i].len() as u64;
+                out.totals[i].add(&self.stats[i]);
+            }
+        }
+    }
+    fn keys(position: &Position) -> [Vec<u8>; 3] {
+        let mut royal = vec![0; 1 + 2 * BOARD_SQUARE_COUNT];
+        let mut material = vec![0; 1 + COLOR_COUNT * PIECE_KIND_COUNT * 2];
+        royal[0] = position.side_to_move().index() as u8;
+        material[0] = royal[0];
+        for square in crate::Square::all() {
+            if let Some(piece) = position.piece_at(square) {
+                let color = piece.color().unwrap().index();
+                let kind = piece.kind().unwrap();
+                material[1
+                    + (color * PIECE_KIND_COUNT + kind.index()) * 2
+                    + usize::from(piece.is_promoted())] += 1;
+                if matches!(kind, PieceKind::King | PieceKind::CrownPrince) {
+                    royal[1 + color * BOARD_SQUARE_COUNT + square.dense_index()] = 1;
+                }
+            }
+        }
+        let combined = [royal.as_slice(), material.as_slice()].concat();
+        [royal, material, combined]
+    }
+    pub(super) struct Node {
+        depth: u32,
+        nonpv: bool,
+        pub eligible: bool,
+        pub improving: &'static str,
+        pub eval: i32,
+        alpha: i32,
+        pub attacked: bool,
+        pub lmr: u64,
+        pub changed: u64,
+    }
+    impl Node {
+        pub fn new(
+            position: &Position,
+            depth: u32,
+            alpha: i32,
+            beta: i32,
+            eval: i32,
+            improving: &'static str,
+        ) -> Self {
+            let nonpv = beta - alpha == 1;
+            let eligible =
+                depth <= 3 && nonpv && alpha.abs() < MATE_THRESHOLD && beta.abs() < MATE_THRESHOLD;
+            let attacked = eligible && royal_under_attack(position);
+            if eligible {
+                let royals: Vec<_> = crate::Square::all()
+                    .filter(|&sq| {
+                        position.piece_at(sq).is_some_and(|p| {
+                            p.color() == Some(position.side_to_move())
+                                && matches!(
+                                    p.kind(),
+                                    Some(PieceKind::King | PieceKind::CrownPrince)
+                                )
+                        })
+                    })
+                    .collect();
+                let reference = crate::Square::all().any(|sq| {
+                    position.piece_at(sq).is_some_and(|p| {
+                        p.color() == Some(position.side_to_move().opposite())
+                            && royals.iter().any(|&target| {
+                                crate::core::movegen::piece_control_with_occupancy(
+                                    position.occupied(),
+                                    p.color().unwrap(),
+                                    p.kind().unwrap(),
+                                    sq,
+                                )
+                                .contains(target)
+                            })
+                    })
+                });
+                assert_eq!(attacked, reference);
+            }
+            Self {
+                depth,
+                nonpv,
+                eligible,
+                improving,
+                eval,
+                alpha,
+                attacked,
+                lmr: 0,
+                changed: 0,
+            }
+        }
+        pub fn write(&self) {
+            if passive_enabled() {
+                line(
+                    "nodes",
+                    format!(
+                        "{} {} {} {} {} {} {} {} {}",
+                        self.depth,
+                        self.nonpv as u8,
+                        self.eligible as u8,
+                        self.improving,
+                        self.eval,
+                        self.alpha,
+                        if self.eligible {
+                            if self.attacked { "1" } else { "0" }
+                        } else {
+                            "-"
+                        },
+                        self.lmr,
+                        self.changed
+                    ),
+                );
+            }
+        }
+    }
+    pub(super) fn check_move(position: &Position, mv: Move, capture: bool, rules: MoveRules) {
+        let enemy = position.side_to_move().opposite();
+        let captured: Vec<_> = [Some(mv.to), mv.mid]
+            .into_iter()
+            .flatten()
+            .filter(|&sq| {
+                position
+                    .piece_at(sq)
+                    .is_some_and(|p| p.color() == Some(enemy))
+            })
+            .collect();
+        assert_eq!(capture, !captured.is_empty());
+        let royals: Vec<_> = crate::Square::all()
+            .filter(|&sq| {
+                position.piece_at(sq).is_some_and(|p| {
+                    p.color() == Some(enemy)
+                        && matches!(p.kind(), Some(PieceKind::King | PieceKind::CrownPrince))
+                })
+            })
+            .collect();
+        assert_eq!(
+            captures_last_royal(position, mv),
+            !royals.is_empty() && royals.iter().all(|sq| captured.contains(sq))
+        );
+        let mut after = position.clone();
+        after.make_move_unchecked(mv, rules);
+        assert_eq!(
+            mv.promote,
+            position.piece_at(mv.from).unwrap().kind() != after.piece_at(mv.to).unwrap().kind()
+        );
+    }
+}

+/// 段階8再診断専用の一時診断。benchだけが初期化する。
+pub mod diagnostics {
+    use super::*;
+    use serde::Serialize;
+    use std::collections::{BTreeMap, HashMap};
+    use std::fs::{File, create_dir_all};

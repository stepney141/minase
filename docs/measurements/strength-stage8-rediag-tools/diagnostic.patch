+    #[allow(clippy::too_many_arguments)]
+    fn diagnostic_search(
+        &mut self,
+        position: &Position,
+        mv: Move,
+        depth: u32,
+        alpha: i32,
+        beta: i32,
+        ply: u32,
+        first: bool,
+        reduction: u32,
+        raw: bool,
+    ) -> bool {
+        let mut tt = self.diag.as_mut().unwrap().reference_tt.take().unwrap();
+        tt.clear();
+        let stop = AtomicBool::new(false);
+        let shared = SharedSearch {
+            external_stop: &stop,
+            team_stop: AtomicBool::new(false),
+            stop_reason: AtomicU8::new(0),
+            total_nodes: AtomicU64::new(0),
+            node_limit: None,
+            started: Instant::now(),
+            hard_limit: None,
+        };
+        let mut reference = new_searcher(
+            self.pst,
+            position,
+            self.rules,
+            self.history_keys,
+            &shared,
+            &tt,
+        );
+        reference.history.clone_from(&self.history);
+        reference.killers = self.killers;
+        reference.accumulators = self.accumulators;
+        reference.path_keys.clone_from(&self.path_keys);
+        reference.null_move_ply = self.null_move_ply;
+        reference.pv.clone_from(&self.pv);
+        let mut board = position.clone();
+        let score = if raw {
+            // A first move with a zero window performs exactly one child search.
+            reference.search_move(
+                &mut board,
+                mv,
+                depth - reduction,
+                alpha,
+                alpha + 1,
+                ply,
+                true,
+                0,
+            )
+        } else {
+            reference.search_move(&mut board, mv, depth, alpha, beta, ply, first, reduction)
+        }
+        .expect("unlimited reference search completes");
+        drop(reference);
+        self.diag.as_mut().unwrap().reference_tt = Some(tt);
+        score > alpha
+    }
